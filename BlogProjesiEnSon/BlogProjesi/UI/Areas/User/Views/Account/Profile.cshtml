@model Business.DTOs.UserDTOs.UserProfileDTO
@{
    ViewData["Title"] = "Profilim";
    Layout = "_UserLayout";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <!-- Başarı / Hata Mesajları -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- PROFİL KARTI -->
            <div class="card mb-5 border-0 shadow-sm">
                <div class="card-header text-white" style="background: linear-gradient(45deg, #3f51b5, #2196f3);">
                    <h4 class="mb-0">
                        <i class="fas fa-user-cog me-2"></i>Profil Yönetimi
                    </h4>
                </div>
                <div class="card-body text-center">

                    <!-- Profil Resmi -->
                    <div class="mx-auto position-relative" style="width: 150px; height: 150px;">
                        <div class="rounded-circle w-100 h-100" style="
                            background-image: url('/images/avatar/@Model.ProfileImage');
                            background-size: cover;
                            background-position: center;
                            border: 6px solid transparent;
                            background-clip: content-box;
                            border-radius: 50%;
                            background-origin: border-box;
                            background-repeat: no-repeat;

                            /* ChatGPT tarzı gradient çerçeve */
                            box-shadow: 0 0 0 4px #fff, 0 0 0 6px linear-gradient(45deg, #3f51b5, #2196f3);
                            background-clip: padding-box;
                            ">
                        </div>
                    </div>

                    <!-- Dosya Yükleme (Tek Giriş) -->
                    <form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" class="mt-3">
                        <div class="input-group justify-content-center">
                            <input type="file" class="form-control d-none" name="ProfileImage"
                                   id="profileImageUpload" accept="image/*"
                                   onchange="this.form.submit()" />
                            <label for="profileImageUpload" class="btn btn-outline-primary">
                                <i class="fas fa-camera me-1"></i>Resmi Değiştir
                            </label>
                        </div>
                    </form>

                    <!-- Profil Bilgileri Formu -->
                    <form asp-action="UpdateProfile" method="post" class="row g-3 mt-4">
                        <!-- Gizli Email Gönderimi -->
                        <input type="hidden" name="Email" value="@Model.Email" />

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ad Soyad</label>
                            <input type="text" class="form-control" name="FullName"
                                   value="@Model.FullName" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kullanıcı Adı</label>
                            <div class="input-group">
                                <span class="input-group-text">@@</span>
                                <input type="text" class="form-control" name="UserName"
                                       value="@Model.UserName" required />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">E-Posta Adresi</label>
                            <input type="email" class="form-control" value="@Model.Email" readonly />
                        </div>

                        <div class="col-12 text-end mt-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ŞİFRE DEĞİŞTİRME KARTI -->
            <div class="card border-0 shadow-sm">
                <div class="card-header text-white" style="background: linear-gradient(45deg, #ff416c, #ff4b2b);">
                    <h4 class="mb-0">
                        <i class="fas fa-lock me-2"></i>Şifre Değiştir
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post" id="passwordForm">

                        <!-- Mevcut Şifre -->
                        <div class="mb-3 password-container">
                            <label for="currentPassword" class="form-label fw-bold">Mevcut Şifre</label>
                            <div class="input-group position-relative">
                                <input id="currentPassword"
                                       class="form-control"
                                       name="CurrentPassword"
                                       type="password"
                                       required
                                       placeholder="••••••••"
                                       style="padding-right: 65px;" />

                                <!-- Valorant Tarzı Caps Lock Uyarısı -->
                                <div class="caps-lock-warning" id="capsLockWarningCurrent">
                                    <i class="fas fa-arrow-up"></i>
                                </div>

                                <!-- Şifre Göster/Gizle Butonu -->
                                <button type="button"
                                        class="input-group-text toggle-password bg-white border-start-0 px-3"
                                        style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                        data-target="currentPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Yeni Şifre -->
                        <div class="mb-3 password-container">
                            <label for="newPassword" class="form-label fw-bold">Yeni Şifre</label>
                            <div class="input-group position-relative">
                                <input id="newPassword"
                                       class="form-control"
                                       name="NewPassword"
                                       type="password"
                                       required
                                       placeholder="••••••••"
                                       style="padding-right: 65px;"
                                       pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[$!%*?&])[A-Za-z\d$!%*?&]{8,}$"
                                       title="En az 8 karakter, bir büyük harf, bir rakam ve bir özel karakter ($!%*?&) içermeli." />

                                <!-- Valorant Tarzı Caps Lock Uyarısı -->
                                <div class="caps-lock-warning" id="capsLockWarningNew">
                                    <i class="fas fa-arrow-up"></i>
                                </div>

                                <!-- Şifre Göster/Gizle Butonu -->
                                <button type="button"
                                        class="input-group-text toggle-password bg-white border-start-0 px-3"
                                        style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                        data-target="newPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>

                            <!-- Şifre Kuralları -->
                            <div class="mt-2 row row-cols-2 gx-2 text-muted" id="passwordRules">
                                <div class="col d-flex align-items-center" data-rule="length">
                                    <i class="fas fa-circle me-2"></i>En az 8 karakter
                                </div>
                                <div class="col d-flex align-items-center" data-rule="uppercase">
                                    <i class="fas fa-circle me-2"></i>Bir büyük harf
                                </div>
                                <div class="col d-flex align-items-center" data-rule="number">
                                    <i class="fas fa-circle me-2"></i>Bir rakam
                                </div>
                                <div class="col d-flex align-items-center" data-rule="special">
                                    <i class="fas fa-circle me-2"></i>Bir özel karakter ($!%*?&)
                                </div>
                            </div>
                        </div>

                        <!-- Yeni Şifre (Tekrar) -->
                        <div class="mb-3 password-container">
                            <label for="confirmPassword" class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                            <div class="input-group position-relative">
                                <input id="confirmPassword"
                                       class="form-control"
                                       name="ConfirmPassword"
                                       type="password"
                                       required
                                       placeholder="••••••••"
                                       style="padding-right: 65px;" />

                                <!-- Valorant Tarzı Caps Lock Uyarısı -->
                                <div class="caps-lock-warning" id="capsLockWarningConfirm">
                                    <i class="fas fa-arrow-up"></i>
                                </div>

                                <!-- Şifre Göster/Gizle Butonu -->
                                <button type="button"
                                        class="input-group-text toggle-password bg-white border-start-0 px-3"
                                        style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                        data-target="confirmPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>

                            <!-- Şifre Eşleşme -->
                            <div class="password-match text-success mt-2 d-none">
                                <i class="fas fa-check-circle me-1"></i>Şifreler eşleşiyor
                            </div>
                            <div class="password-mismatch text-danger mt-2 d-none">
                                <i class="fas fa-times-circle me-1"></i>Şifreler uyuşmuyor!
                            </div>
                        </div>

                        <!-- Buton -->
                        <div class="text-end">
                            <button type="submit" class="btn btn-danger btn-lg px-4" id="submitBtn" disabled>
                                <i class="fas fa-key me-2"></i>Şifreyi Değiştir
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<style>


    /* ====== Şifre Alanı Düzenlemeleri ====== */
    .password-container {
        position: relative;
    }

    .input-group-text.toggle-password {
        cursor: pointer;
    }

    /* Valorant Tarzı Caps Lock Uyarısı */
    .caps-lock-warning {
        display: none;
        position: absolute;
        top: 50%;
        right: 50px; /* Göz butonundan biraz solda */
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        background: #ff4655;
        border-radius: 50%;
        box-shadow: 0 0 12px rgba(255, 70, 85, 0.6);
        animation: valorant-pulse 1.2s infinite;
        border: 2px solid #fff;
        z-index: 10;
        align-items: center;
        justify-content: center;
    }

        .caps-lock-warning i {
            color: white;
            font-size: 10px;
            transform: translateY(-1px) rotate(45deg);
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

    @@keyframes valorant-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 70, 85, 0.6), inset 0 0 0 0 rgba(255,255,255,0.1);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(255, 70, 85, 0), inset 0 0 4px 2px rgba(255,255,255,0.2);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 70, 85, 0), inset 0 0 0 0 rgba(255,255,255,0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // 1) Şifre Göster/Gizle (Göz)
        document.querySelectorAll(".toggle-password").forEach(btn => {
            btn.addEventListener("click", function() {
                const targetInput = document.getElementById(this.dataset.target);
                const icon = this.querySelector("i");
                if (targetInput.type === "password") {
                    targetInput.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    targetInput.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                }
            });
        });

        // 2) Valorant Tarzı Caps Lock Uyarısı
        //    Her üç şifre inputu için ayrı ID kullandık: capsLockWarningCurrent, capsLockWarningNew, capsLockWarningConfirm
        const currentPassword  = document.getElementById("currentPassword");
        const newPassword      = document.getElementById("newPassword");
        const confirmPassword  = document.getElementById("confirmPassword");

        function showHideCapsLock(e, warningId) {
            const isCaps = e.getModifierState && e.getModifierState("CapsLock");
            const warningEl = document.getElementById(warningId);
            if (warningEl) {
                warningEl.style.display = isCaps ? 'flex' : 'none';
            }
        }

        currentPassword.addEventListener("keyup", (e) => showHideCapsLock(e, "capsLockWarningCurrent"));
        newPassword.addEventListener("keyup", (e) => showHideCapsLock(e, "capsLockWarningNew"));
        confirmPassword.addEventListener("keyup", (e) => showHideCapsLock(e, "capsLockWarningConfirm"));

        // 3) Şifre Kuralları ve Eşleşme
        const submitBtn = document.getElementById("submitBtn");

        // Kurallar
        const rules = {
            length: val => val.length >= 8,
            uppercase: val => /[A-Z]/.test(val),
            number: val => /\d/.test(val),
            special: val => /[$!%*?&]/.test(val),
        };

        function checkPasswordRules(password) {
            let allValid = true;
            for (let ruleKey in rules) {
                const isValid = rules[ruleKey](password);
                const elem = document.querySelector(`[data-rule="${ruleKey}"]`);
                if (!elem) continue;

                const icon = elem.querySelector("i");
                if (isValid) {
                    elem.classList.add("text-success");
                    elem.classList.remove("text-danger");
                    icon.classList.replace("fa-circle", "fa-check-circle");
                } else {
                    elem.classList.remove("text-success");
                    elem.classList.add("text-danger");
                    icon.classList.replace("fa-check-circle", "fa-circle");
                    allValid = false;
                }
            }
            return allValid;
        }

        function checkMatch(newVal, confirmVal) {
            const match = newVal === confirmVal;
            document.querySelector(".password-match").classList.toggle("d-none", !match);
            document.querySelector(".password-mismatch").classList.toggle("d-none", match);
            return match;
        }

        function validatePasswords() {
            const isRulesOK = checkPasswordRules(newPassword.value);
            const isMatchOK = checkMatch(newPassword.value, confirmPassword.value);
            submitBtn.disabled = !(isRulesOK && isMatchOK);
        }

        newPassword.addEventListener("input", validatePasswords);
        confirmPassword.addEventListener("input", validatePasswords);
    });
</script>
