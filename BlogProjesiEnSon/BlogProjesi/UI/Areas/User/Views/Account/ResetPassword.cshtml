@model UI.Areas.User.Models.AccountVMs.ResetPasswordVM

@{
    ViewData["Title"] = "Şifre Sıfırlama";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Şifrenizi Sıfırlayın</h3>
                <p class="text-muted">Yeni şifrenizi belirleyin</p>
            </div>

            <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <!-- Yeni Şifre -->
                <div class="mb-3 text-start password-container">
                    <label class="form-label">Yeni Şifre</label>
                    <div class="input-group position-relative">
                        <input asp-for="Password" type="password" id="newPassword" class="form-control"
                               placeholder="Yeni şifrenizi girin" required
                               onkeyup="checkPasswordStrength(this.value)" />
                        <!-- Caps Lock Uyarısı -->
                        <div class="caps-lock-warning" id="capsLockWarning1">
                            <i class="fas fa-arrow-up"></i>
                        </div>

                        <!-- Şifre Göster/Gizle -->
                        <button type="button" class="input-group-text toggle-password bg-white border-start-0 px-3"
                                style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                data-target="newPassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>

                    <!-- Şifre Kural Göstergesi -->
                    <div class="password-rules mt-2">
                        <div class="rule" id="length-rule">
                            <i class="fas fa-times text-danger"></i>
                            <span>En az 8 karakter</span>
                        </div>
                        <div class="rule" id="uppercase-rule">
                            <i class="fas fa-times text-danger"></i>
                            <span>Büyük harf (A-Z)</span>
                        </div>
                        <div class="rule" id="lowercase-rule">
                            <i class="fas fa-times text-danger"></i>
                            <span>Küçük harf (a-z)</span>
                        </div>
                        <div class="rule" id="number-rule">
                            <i class="fas fa-times text-danger"></i>
                            <span>Rakam (0-9)</span>
                        </div>
                        <div class="rule" id="special-rule">
                            <i class="fas fa-times text-danger"></i>
                            <span>Özel karakter (!@@#$%^&*)</span>
                        </div>
                    </div>
                </div>

                <!-- Şifre Tekrar -->
                <div class="mb-3 text-start password-container">
                    <label class="form-label">Yeni Şifre (Tekrar)</label>
                    <div class="input-group position-relative">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control"
                               placeholder="Şifreyi tekrar girin" required
                               onkeyup="checkPasswordMatch()" />

                        <!-- Caps Lock Uyarısı -->
                        <div class="caps-lock-warning" id="capsLockWarning2">
                            <i class="fas fa-arrow-up"></i>
                        </div>

                        <!-- Şifre Göster/Gizle -->
                        <button type="button" class="input-group-text toggle-password bg-white border-start-0 px-3"
                                style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                data-target="confirmPassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <div class="mt-2" id="passwordMatchFeedback"></div>
                </div>

                <button type="submit" id="submitButton" class="btn btn-primary w-100 mb-2">Sıfırla</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Şifre Göster/Gizle
            document.querySelectorAll(".toggle-password").forEach(btn => {
                btn.addEventListener("click", function() {
                    const targetInput = document.getElementById(this.dataset.target);
                    const icon = this.querySelector("i");
                    if (targetInput.type === "password") {
                        targetInput.type = "text";
                        icon.classList.replace("fa-eye", "fa-eye-slash");
                    } else {
                        targetInput.type = "password";
                        icon.classList.replace("fa-eye-slash", "fa-eye");
                    }
                });
            });

            // CapsLock Kontrolü (Her iki input için)
            const passwordInputs = document.querySelectorAll('input[type="password"]');
            passwordInputs.forEach((input, index) => {
                input.addEventListener('keyup', function(e) {
                    const isCaps = e.getModifierState && e.getModifierState("CapsLock");
                    document.getElementById(`capsLockWarning${index+1}`).style.display = isCaps ? 'flex' : 'none';
                });
            });
        });

        // Şifre Kuralları Kontrolü
        function checkPasswordStrength(password) {
            const rules = {
                length: password.length >= 8,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                number: /[0-9]/.test(password),
                special: /[!@@#$%^&*]/.test(password)
            };

            let allRulesValid = true;
            Object.keys(rules).forEach(rule => {
                const ruleElement = document.getElementById(`${rule}-rule`);
                if (ruleElement) {
                    const icon = ruleElement.querySelector("i");
                    if (rules[rule]) {
                        icon.classList.replace("fa-times", "fa-check");
                        icon.classList.replace("text-danger", "text-success");
                        ruleElement.classList.add("valid");
                    } else {
                        icon.classList.replace("fa-check", "fa-times");
                        icon.classList.replace("text-success", "text-danger");
                        ruleElement.classList.remove("valid");
                        allRulesValid = false;
                    }
                }
            });

            checkFormValidity();
            return allRulesValid;
        }

        // Şifre Eşleşme Kontrolü
        function checkPasswordMatch() {
            const password = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const feedback = document.getElementById('passwordMatchFeedback');

            if (confirmPassword.length === 0) {
                feedback.innerHTML = '';
                return false;
            }

            if (password === confirmPassword) {
                feedback.innerHTML = '<i class="fas fa-check-circle text-success"></i> Şifreler eşleşiyor';
                return true;
            } else {
                feedback.innerHTML = '<i class="fas fa-times-circle text-danger"></i> Şifreler eşleşmiyor';
                return false;
            }
        }

        // Form Geçerlilik Kontrolü
        function checkFormValidity() {
            const passwordValid = checkPasswordStrength(document.getElementById('newPassword').value);
            const passwordsMatch = checkPasswordMatch();
            const submitButton = document.getElementById('submitButton');

            if (passwordValid && passwordsMatch) {
                submitButton.disabled = false;
            } else {
                submitButton.disabled = false;
            }
        }
    </script>
}

<style>
    /* CapsLock Uyarısı */
    .caps-lock-warning {
        display: none;
        position: absolute;
        top: 50%;
        right: 50px;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        background: #ff4655;
        border-radius: 50%;
        box-shadow: 0 0 12px rgba(255, 70, 85, 0.6);
        animation: valorant-pulse 1.2s infinite;
        border: 2px solid #fff;
        z-index: 10;
        align-items: center;
        justify-content: center;
    }

        .caps-lock-warning i {
            color: white;
            font-size: 10px;
            transform: translateY(-1px) rotate(45deg);
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

    @@keyframes valorant-pulse {
        0%

    {
        box-shadow: 0 0 0 0 rgba(255, 70, 85, 0.6), inset 0 0 0 0 rgba(255,255,255,0.1);
    }

    70% {
        box-shadow: 0 0 0 8px rgba(255, 70, 85, 0), inset 0 0 4px 2px rgba(255,255,255,0.2);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(255, 70, 85, 0), inset 0 0 0 0 rgba(255,255,255,0);
    }

    }

    /* Şifre Kuralları */
    .password-rules {
        background-color: #f8f9fa;
        padding: 10px;
        border-radius: 5px;
        margin-top: 10px;
        font-size: 14px;
    }

    .rule {
        display: flex;
        align-items: center;
        margin-bottom: 5px;
    }

        .rule i {
            margin-right: 8px;
            font-size: 12px;
        }

    /* Şifre Eşleşme Feedback */
    #passwordMatchFeedback {
        font-size: 14px;
    }

    /* Buton Stili */
    #submitButton:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }
</style>
