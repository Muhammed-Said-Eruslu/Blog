@using UI.Areas.User.Models.AccountVMs
@model RegisterVM

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Kayıt Ol</h3>
                <p class="text-muted">Hesap oluşturun ve blogumuza katılın!</p>
            </div>

            <form asp-action="Register" method="post">

                <!-- Ad Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="FirstName" class="form-label">Adınız</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Adınızı giriniz" required />
                </div>

                <!-- Soyad Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="LastName" class="form-label">Soyadınız</label>
                    <input asp-for="LastName" class="form-control" placeholder="Soyadınızı giriniz" required />
                </div>

                <!-- E-posta Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="E-posta adresinizi giriniz" required />
                </div>

                <!-- Şifre Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Şifrenizi giriniz" required />
                </div>

                <!-- Cinsiyet Seçimi -->
                <div class="mb-3 text-start">
                    <label asp-for="Gender" class="form-label">Cinsiyet</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="0">Erkek</option>
                        <option value="1">Kadın</option>
                        <option value="2">Belirtmek İstemiyorum</option>
                    </select>
                </div>

                <!-- Doğum Tarihi -->
                <div class="mb-3 text-start">
                    <label asp-for="BirthDate" class="form-label">Doğum Tarihi</label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>

                <!-- reCAPTCHA -->
                <div class="mb-3">
                    <div class="g-recaptcha d-flex justify-content-center" data-sitekey="6LdSm7sqAAAAAIm9CMwNpsRFhztlFX0NeSl2kT0N"></div>
                    @if (ViewData["CaptchaError"] != null)
                    {
                        <div class="alert alert-danger mt-2">@ViewData["CaptchaError"]</div>
                    }
                </div>

                <!-- Google ile Kayıt Ol -->
                <div class="mb-3">
                    <a asp-action="GoogleRegister" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="me-2">
                            <path fill="currentColor" d="M12.545 10.239v3.821h5.445c-.712 2.315-2.647 3.972-5.445 3.972-3.332 0-6.033-2.701-6.033-6.032s2.701-6.032 6.033-6.032c1.498 0 2.866.549 3.921 1.453l2.814-2.814C17.503 2.332 15.139 1 12.545 1 7.021 1 2.545 5.476 2.545 11s4.476 10 10 10c5.523 0 10-4.476 10-10 0-.671-.069-1.325-.189-1.971H12.545z" />
                        </svg>
                        Google ile Kayıt Ol
                    </a>
                </div>

                <!-- Kayıt Ol Butonu -->
                <button type="submit" class="btn btn-primary w-100 mb-2">Kayıt Ol</button>

                <!-- Zaten üye misiniz? -->
                <div class="text-center mt-3">
                    <p>Zaten bir hesabınız var mı? <a asp-action="Login">Giriş Yap</a></p>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
