@using UI.Areas.User.Models.AccountVMs
@model RegisterVM

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Kayıt Ol</h3>
                <p class="text-muted">Hesap oluşturun ve blogumuza katılın!</p>
            </div>

            <form asp-action="Register" method="post">

                <!-- Ad Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="FirstName" class="form-label">Adınız</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Adınızı giriniz" required />
                </div>

                <!-- Soyad Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="LastName" class="form-label">Soyadınız</label>
                    <input asp-for="LastName" class="form-control" placeholder="Soyadınızı giriniz" required />
                </div>

                <!-- E-posta Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="E-posta adresinizi giriniz" required />
                </div>

                <!-- Şifre Girişi -->
                <div class="mb-3 text-start password-container">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <div class="input-group position-relative">
                        <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Şifrenizi giriniz" required />

                        <!-- Valorant Tarzı Caps Lock Uyarısı -->
                        <div class="caps-lock-warning d-none" id="capsLockWarning">
                            <i class="fas fa-arrow-up"></i>
                        </div>

                        <!-- Şifre Göster/Gizle Butonu -->
                        <button type="button" class="input-group-text toggle-password bg-white border-start-0 px-3"
                                data-target="password">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    
                    <!-- Şifre Kriterleri -->
                    <div class="password-rules mt-2 text-muted">
                        <div class="rule" data-rule="length"><i class="fas fa-circle"></i> En az 8 karakter</div>
                        <div class="rule" data-rule="uppercase"><i class="fas fa-circle"></i> Bir büyük harf</div>
                        <div class="rule" data-rule="lowercase"><i class="fas fa-circle"></i> Bir küçük harf</div>
                        <div class="rule" data-rule="number"><i class="fas fa-circle"></i> Bir rakam</div>
                        <div class="rule" data-rule="special"><i class="fas fa-circle"></i> Bir özel karakter (!@@#$%^&*)</div>
                    </div>
                </div>

                <!-- Cinsiyet Seçimi -->
                <div class="mb-3 text-start">
                    <label asp-for="Gender" class="form-label">Cinsiyet</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Male">Erkek</option>
                        <option value="Female">Kadın</option>
                        <option value="Other">Belirtmek İstemiyorum</option>
                    </select>
                </div>

                <!-- Doğum Tarihi -->
                <div class="mb-3 text-start">
                    <label asp-for="BirthDate" class="form-label">Doğum Tarihi</label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>

                <!-- reCAPTCHA -->
                <div class="mb-3">
                    <div class="g-recaptcha d-flex justify-content-center" data-sitekey="6LdSm7sqAAAAAIm9CMwNpsRFhztlFX0NeSl2kT0N"></div>
                    @if (ViewData["CaptchaError"] != null)
                    {
                        <div class="alert alert-danger mt-2">@ViewData["CaptchaError"]</div>
                    }
                </div>

                <!-- Kayıt Ol Butonu -->
                <button type="submit" class="btn btn-primary w-100 mb-2">Kayıt Ol</button>

                <!-- Zaten üye misiniz? -->
                <div class="text-center mt-3">
                    <p>Zaten bir hesabınız var mı? <a asp-action="Login">Giriş Yap</a></p>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}

<style>
    /* Şifre Alanı */
    .password-container {
        position: relative;
    }
    .input-group-text.toggle-password {
        cursor: pointer;
    }
    /* Valorant Tarzı Caps Lock Uyarısı */
    .caps-lock-warning {
        display: flex;
        position: absolute;
        top: 50%;
        right: 50px;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        background: #ff4655;
        border-radius: 50%;
        box-shadow: 0 0 12px rgba(255, 70, 85, 0.6);
        animation: valorant-pulse 1.2s infinite;
        border: 2px solid #fff;
        z-index: 10;
        align-items: center;
        justify-content: center;
    }
    .caps-lock-warning i {
        color: white;
        font-size: 10px;
        transform: translateY(-1px) rotate(45deg);
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    /* Şifre Kriterleri */
    .password-rules {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        font-size: 0.9rem;
    }
    .rule[data-fulfilled="true"] {
        color: #28a745;
    }
    .rule i {
        margin-right: 5px;
    }
    @@keyframes valorant-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 70, 85, 0.6);
        }
        70% {
            box-shadow: 0 0 0 8px rgba(255, 70, 85, 0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // Şifre Göster/Gizle Butonu
        document.querySelector(".toggle-password").addEventListener("click", function() {
            const targetInput = document.getElementById(this.dataset.target);
            const icon = this.querySelector("i");
            targetInput.type = (targetInput.type === "password") ? "text" : "password";
            icon.classList.toggle("fa-eye-slash");
        });

        // Caps Lock Uyarısı
        document.getElementById("password").addEventListener("keyup", (e) => {
            document.getElementById("capsLockWarning").classList.toggle("d-none", !e.getModifierState("CapsLock"));
        });

        // Şifre Kriterleri Kontrolü
        const passwordField = document.getElementById("password");
        const rules = {
            length: val => val.length >= 8,
            uppercase: val => /[A-Z]/.test(val),
            lowercase: val => /[a-z]/.test(val),
            number: val => /\d/.test(val),
            special: val => /[!@@#$%^&*]/.test(val)
        };

        function checkPasswordRules(password) {
            for (let ruleKey in rules) {
                const isValid = rules[ruleKey](password);
                const elem = document.querySelector(`[data-rule="${ruleKey}"]`);
                if (!elem) continue;
                const icon = elem.querySelector("i");
                icon.className = isValid ? "fas fa-check-circle text-success" : "fas fa-circle text-danger";
                // Set attribute to mark rule status
                elem.setAttribute("data-fulfilled", isValid);
            }
        }

        passwordField.addEventListener("input", () => {
            checkPasswordRules(passwordField.value);
        });
    });
</script>
