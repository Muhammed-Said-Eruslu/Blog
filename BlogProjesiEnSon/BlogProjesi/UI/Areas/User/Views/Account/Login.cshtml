@model UI.Areas.User.Models.AccountVMs.LoginVM

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Giriş Yap</h3>
                <p class="text-muted">Blogumuza Hoş Geldiniz</p>
            </div>

            <form  asp-action="Login" method="post">

                <!-- Email Girişi -->
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Email" class="form-control" placeholder="Email giriniz" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Şifre Girişi -->
                <div class="mb-3 text-start password-container">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <div class="input-group position-relative">
                        <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Şifre giriniz" required />

                        <!-- Valorant Tarzı Caps Lock Uyarısı -->
                        <div class="caps-lock-warning" id="capsLockWarning">
                            <i class="fas fa-arrow-up"></i>
                        </div>

                        <!-- Şifre Göster/Gizle Butonu -->
                        <button type="button" class="input-group-text toggle-password bg-white border-start-0 px-3"
                                style="position: absolute; right: 0; z-index: 5; height: calc(100% - 2px); width: 45px;"
                                data-target="password">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Beni Hatırla -->
                <div class="form-check mb-3 text-start">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Beni Hatırla
                    </label>
                </div>

                <!-- reCAPTCHA -->
                <div class="mb-3">
                    <div class="g-recaptcha d-flex justify-content-center" data-sitekey="6LdSm7sqAAAAAIm9CMwNpsRFhztlFX0NeSl2kT0N"></div>
                    @if (ViewData["CaptchaError"] != null)
                    {
                        <div class="alert alert-danger mt-2">@ViewData["CaptchaError"]</div>
                    }
                </div>

                <!-- Google ile Giriş Butonu -->
                <div class="mb-3">
                    <a asp-action="GoogleLogin" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="me-2">
                            <path fill="currentColor" d="M12.545 10.239v3.821h5.445c-.712 2.315-2.647 3.972-5.445 3.972-3.332 0-6.033-2.701-6.033-6.032s2.701-6.032 6.033-6.032c1.498 0 2.866.549 3.921 1.453l2.814-2.814C17.503 2.332 15.139 1 12.545 1 7.021 1 2.545 5.476 2.545 11s4.476 10 10 10c5.523 0 10-4.476 10-10 0-.671-.069-1.325-.189-1.971H12.545z" />
                        </svg>
                        Google ile Giriş Yap
                    </a>
                </div>

                <!-- Giriş Yap Butonu -->
                <button type="submit"  class="btn btn-primary w-100 mb-2">Giriş Yap</button>

                <!-- Kayıt Ol Butonu -->
                <a asp-action="Register" class="btn btn-outline-secondary w-100">Kayıt Ol</a>

                <!-- Şifremi Unuttum -->
                <div class="text-center mt-3">
                    <a href="#">Şifreni mi unuttun?</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}

<style>
    /* ====== Şifre Alanı Düzenlemeleri ====== */
    .password-container {
        position: relative;
    }

    .input-group-text.toggle-password {
        cursor: pointer;
    }

    /* Valorant Tarzı Caps Lock Uyarısı */
    .caps-lock-warning {
        display: none;
        position: absolute;
        top: 50%;
        right: 50px; /* Göz butonundan biraz solda */
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        background: #ff4655;
        border-radius: 50%;
        box-shadow: 0 0 12px rgba(255, 70, 85, 0.6);
        animation: valorant-pulse 1.2s infinite;
        border: 2px solid #fff;
        z-index: 10;
        align-items: center;
        justify-content: center;
    }

        .caps-lock-warning i {
            color: white;
            font-size: 10px;
            transform: translateY(-1px) rotate(45deg);
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

    @@keyframes valorant-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 70, 85, 0.6), inset 0 0 0 0 rgba(255,255,255,0.1);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(255, 70, 85, 0), inset 0 0 4px 2px rgba(255,255,255,0.2);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 70, 85, 0), inset 0 0 0 0 rgba(255,255,255,0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // 1) Şifre Göster/Gizle (Göz)
        document.querySelectorAll(".toggle-password").forEach(btn => {
            btn.addEventListener("click", function() {
                const targetInput = document.getElementById(this.dataset.target);
                const icon = this.querySelector("i");
                if (targetInput.type === "password") {
                    targetInput.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    targetInput.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                }
            });
        });

        // 2) Valorant Tarzı Caps Lock Uyarısı
        function showHideCapsLock(e) {
            const isCaps = e.getModifierState && e.getModifierState("CapsLock");
            const warningEl = document.getElementById("capsLockWarning");
            if (warningEl) {
                warningEl.style.display = isCaps ? 'flex' : 'none';
            }
        }

        const passwordInput = document.getElementById("password");
        passwordInput.addEventListener("keyup", showHideCapsLock);
    });
</script>
