@{
    ViewData["Title"] = "Şifre Sıfırlama Bağlantısı Gönderildi";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Şifre Sıfırlama Bağlantısı Gönderildi</h3>
            </div>

            <p class="mb-4">
                E-posta adresinize şifre sıfırlama bağlantısı gönderildi.
                Lütfen e-postanızı kontrol edin.
            </p>

            <div class="text-center mt-3">
                <a asp-action="Login" class="btn btn-outline-primary">Giriş sayfasına dön</a>
            </div>
        </div>
    </div>
</div>