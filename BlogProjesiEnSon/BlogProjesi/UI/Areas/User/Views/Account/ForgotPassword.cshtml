@model UI.Areas.User.Models.AccountVMs.ForgotPasswordVM

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Şifremi Unuttum</h3>
                <p class="text-muted">Şifre sıfırlama bağlantısı almak için e-posta adresinizi girin</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Email" class="form-control" placeholder="Email giriniz" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-2">Gönder</button>

                <div class="text-center mt-3">
                    <a asp-action="Login" class="text-decoration-none">Giriş sayfasına dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}