@{
    ViewData["Title"] = "Şifre Sıfırlama Başarılı";
    Layout = "_UserLayout";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 text-center">
            <div class="text-center mb-4">
                <h3 class="fw-bold">Şifreniz Başarıyla Sıfırlandı</h3>
            </div>

            <p class="mb-4">
                Şifreniz başarıyla sıfırlandı. Artık yeni şifrenizle giriş yapabilirsiniz.
            </p>

            <div class="text-center mt-3">
                <a asp-action="Login" class="btn btn-primary">Giriş Yap</a>
            </div>
        </div>
    </div>
</div>