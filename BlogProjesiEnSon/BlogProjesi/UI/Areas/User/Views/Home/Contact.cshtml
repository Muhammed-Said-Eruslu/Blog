@using Domain.Entites
@model Contact
@{
    Layout = "_UserLayout";
}
<!-- Contact.cshtml -->
<section class="ftco-section contact-section">
    <div class="container px-md-5">
        <div class="row d-flex mb-5 contact-info">
            <div class="col-md-12 mb-4">
                <h2 class="h3">İletişim</h2>
                <p>Sorularınız veya görüşleriniz için bize ulaşın</p>
            </div>
            <div class="w-100"></div>
            <div class="col-md-4 d-flex">
                <div class="info bg-light p-4">
                    <p><span>Adres:</span> Afyonkarahisar, Türkiye</p>
                </div>
            </div>
            <div class="col-md-4 d-flex">
                <div class="info bg-light p-4">
                    <p><span>Telefon:</span> <a href="tel:+905555555555">+90 555 555 55 55</a></p>
                </div>
            </div>
            <div class="col-md-4 d-flex">
                <div class="info bg-light p-4">
                    <p><span>Email:</span> <a href="mailto:info@example.com">info@example.com</a></p>
                </div>
            </div>
        </div>
        <div class="row block-9">
            <div class="col-lg-6 d-flex">
                <div class="bg-light p-5 contact-form w-100">
                    <form asp-action="Contact" method="post" class="mb-5">
                        <div class="form-group">
                            <input type="text" class="form-control" placeholder="Adınız Soyadınız" required asp-for="FullName">
                        </div>
                        <div class="form-group">
                            <input type="email" class="form-control" placeholder="E-posta Adresiniz" required asp-for="Email">
                        </div>
                        <div class="form-group">
                            <input type="text" class="form-control" placeholder="Konu" asp-for="Subject">
                        </div>
                        <div class="form-group">
                            <textarea cols="30" rows="7" class="form-control" placeholder="Mesajınız..." required asp-for="Message"></textarea>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary py-3 px-5 w-100">
                                <i class="fas fa-paper-plane me-2"></i>Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-6 d-flex">
                <div class="bg-light p-5 w-100">
                    <div class="mapouter">
                        <div class="gmap_canvas">
                            <iframe width="100%" height="400" id="gmap_canvas"
                                    src="https://maps.google.com/maps?q=Afyonkarahisar&t=&z=13&ie=UTF8&iwloc=&output=embed"
                                    frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
                        </div>
                    </div>

                    <div class="social-links mt-4 text-center">
                        <a href="#" class="social-icon"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-github"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-section {
        background: #f8f9fa;
        padding: 5rem 0;
    }

    .contact-info .info {
        border-radius: 8px;
        transition: all 0.3s ease;
        border-left: 4px solid #6c5ce7;
    }

        .contact-info .info:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .contact-info span {
        font-weight: 600;
        color: #6c5ce7;
    }

    .contact-form {
        border-radius: 8px;
    }

        .contact-form .form-control {
            height: 50px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
            margin-bottom: 20px;
        }

        .contact-form textarea.form-control {
            height: auto;
        }

        .contact-form .form-control:focus {
            border-color: #6c5ce7;
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.25);
        }

    .social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #6c5ce7;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 5px;
        transition: all 0.3s ease;
    }

        .social-icon:hover {
            background: #5649c0;
            transform: translateY(-3px);
        }

    @@media (max-width: 768px) {
        .contact-section {
            padding: 3rem 0;
        }

        .contact-info .info {
            margin-bottom: 20px;
        }

        .contact-form, .mapouter {
            margin-bottom: 30px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Form gönderim başarılıysa bildirim göster
        $(document).ready(function() {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: successMessage,
                    confirmButtonColor: '#6c5ce7'
                });
            }

            // Form validation
            $("#contactForm").validate({
                errorClass: "is-invalid",
                validClass: "is-valid",
                errorPlacement: function(error, element) {
                    error.addClass("invalid-feedback");
                    element.after(error);
                },
                highlight: function(element, errorClass, validClass) {
                    $(element).addClass(errorClass).removeClass(validClass);
                },
                unhighlight: function(element, errorClass, validClass) {
                    $(element).removeClass(errorClass).addClass(validClass);
                }
            });
        });
    </script>
}