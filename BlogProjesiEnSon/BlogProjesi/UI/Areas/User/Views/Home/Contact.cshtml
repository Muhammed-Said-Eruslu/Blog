@using Domain.Entites
@model Contact
@{
    Layout = "_UserLayout";
}
<!-- Contact.cshtml -->
<div class="contact-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="contact-card glass-card">
                    <h2 class="section-title">İletişim</h2>
                    <p class="section-subtitle">Sorularınız veya görüşleriniz için bize ulaşın</p>

                    <div class="row g-5">
                        <!-- İletişim Bilgileri -->
                        <div class="col-md-6">
                            <div class="contact-info">
                                <div class="info-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <div>
                                        <h5>Adres</h5>
                                        <p>Afyonkarahisar, Türkiye</p>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <i class="fas fa-envelope"></i>
                                    <div>
                                        <h5>E-posta</h5>
                                        <p>info@example.com</p>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <i class="fas fa-phone"></i>
                                    <div>
                                        <h5>Telefon</h5>
                                        <p>+90 555 555 55 55</p>
                                    </div>
                                </div>

                                <div class="social-links mt-4">
                                    <a href="#" class="social-icon"><i class="fab fa-linkedin"></i></a>
                                    <a href="#" class="social-icon"><i class="fab fa-github"></i></a>
                                    <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                                    <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                                </div>
                            </div>
                        </div>

                        <!-- İletişim Formu -->
                        <div class="col-md-6">
                        <form id="contactForm" asp-action="Contact" method="post" class="contact-form">

                            <div class="mb-3">
                                <input type="text" class="form-control" placeholder="Adınız Soyadınız" required asp-for="FullName">
                            </div>

                            <div class="mb-3">
                                <input type="email" class="form-control" placeholder="E-posta Adresiniz" required asp-for="Email">
                            </div>

                            <div class="mb-3">
                                <input type="text" class="form-control" placeholder="Konu" asp-for="Subject">
                            </div>

                            <div class="mb-3">
                                <textarea class="form-control" rows="5" placeholder="Mesajınız..." required asp-for="Message"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-paper-plane me-2"></i>Gönder
                            </button>
                        </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-section {
        padding: 5rem 0;
        background: linear-gradient(45deg, #1a1a1a, #2d2d2d);
        min-height: 100vh;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 2.5rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .section-title {
        color: #007bff;
        font-weight: 700;
        margin-bottom: 1rem;
        position: relative;
        padding-bottom: 0.5rem;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 50px;
            height: 3px;
            background: #17a2b8;
        }

    .section-subtitle {
        color: #adb5bd;
        margin-bottom: 2.5rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 10px;
        transition: transform 0.3s ease;
    }

        .info-item:hover {
            transform: translateX(10px);
        }

        .info-item i {
            font-size: 1.5rem;
            color: #17a2b8;
            margin-right: 1rem;
            width: 40px;
            text-align: center;
        }

        .info-item h5 {
            color: #fff;
            margin-bottom: 0.3rem;
        }

        .info-item p {
            color: #adb5bd;
            margin: 0;
        }

    .contact-form .form-control {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .contact-form .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #17a2b8;
            box-shadow: none;
        }

    .social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.75rem;
        transition: all 0.3s ease;
    }

        .social-icon:hover {
            background: #007bff;
            transform: translateY(-3px);
        }

    @@media (max-width: 768px) {
        .contact-section {
            padding: 3rem 0;
        }

        .glass-card {
            padding: 1.5rem;
        }

        .info-item {
            flex-direction: column;
            text-align: center;
        }

            .info-item i {
                margin-right: 0;
                margin-bottom: 0.5rem;
            }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}