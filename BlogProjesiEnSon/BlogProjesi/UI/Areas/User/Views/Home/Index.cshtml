@using Business.DTOs.PostDTOs
@model Business.DTOs.PostDTOs.PaginatedList<Business.DTOs.PostDTOs.PostListDTO>
@{
    Layout = "_UserLayout";
}

<!-- ================= ARA ÇUBUĞU ================= -->
<section class="search-bar py-4 bg-light position-relative">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text"
                               id="searchQueryInput"
                               name="searchQuery"
                               class="form-control form-control-lg border-pill"
                               placeholder="Makale ara..."
                               value="@ViewBag.SearchQuery"
                               autocomplete="off" />

                        <div class="input-group-append">
                            <button class="btn btn-primary btn-lg border-pill" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
                <!-- Canlı arama sonuçlarını buraya koyacağız -->
                <div id="autocompleteList" class="list-group position-absolute w-100" style="z-index:999;"></div>
            </div>
        </div>
    </div>
</section>

<!-- ================= FULLSCREEN CAROUSEL ================= -->
<section class="mb-5">
    <div id="topCarousel" class="carousel slide" data-ride="carousel" data-interval="5000">
        <ol class="carousel-indicators circle-indicators">
            <li data-target="#topCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#topCarousel" data-slide-to="1"></li>
            <li data-target="#topCarousel" data-slide-to="2"></li>
        </ol>

        <div class="carousel-inner">
            <!-- Ana Sayfa Slaytı -->
            <div class="carousel-item active">
                <div class="carousel-overlay"></div>
                @* <img src="~/images/carousel1.jpg" class="d-block w-100" alt="Ana Sayfa"> *@
                <div class="carousel-caption animate__animated animate__fadeInUp">
                    <h2 class="display-4">Blog'uma Hoş Geldiniz</h2>
                    <p class="lead">En son yazılarım ve paylaşımlarım</p>
                    <a href="@Url.Action("Index", "Home", new { area = "User" })" class="btn btn-outline-light btn-lg">Ana Sayfa</a>
                </div>
            </div>

            <!-- Hakkımda Slaytı -->
            <div class="carousel-item">
                <div class="carousel-overlay"></div>
                @* <img src="~/images/carousel2.jpg" class="d-block w-100" alt="Hakkımda"> *@
                <div class="carousel-caption animate__animated animate__fadeInUp">
                    <h2 class="display-4">Ben Kimim?</h2>
                    <p class="lead">Deneyimlerim ve tutkularım hakkında bilgi edinin</p>
                    <a href="@Url.Action("About", "Home", new { area = "User" })" class="btn btn-outline-light btn-lg">Hakkımda</a>
                </div>
            </div>

            <!-- İletişim Slaytı -->
            <div class="carousel-item">
                <div class="carousel-overlay"></div>
                @* <img src="~/images/carousel3.jpg" class="d-block w-100" alt="İletişim"> *@
                <div class="carousel-caption animate__animated animate__fadeInUp">
                    <h2 class="display-4">İletişime Geçin</h2>
                    <p class="lead">Sorularınız veya işbirliği teklifleriniz için bana ulaşın</p>
                    <a href="@Url.Action("Contact", "Home", new { area = "User" })" class="btn btn-outline-light btn-lg">İletişim</a>
                </div>
            </div>
        </div>

        <a class="carousel-control-prev" href="#topCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#topCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
</section>


<!-- ================= POPÜLER YAZILAR ================= -->
<section class="popular-posts bg-light py-5">
    <div class="container">
        <div class="section-header text-center mb-4">
            <h2 class="section-title display-5 mb-3">Haftanın Popülerleri</h2>
            <div class="divider mx-auto"></div>
            <p class="lead text-muted">Bu hafta en çok okunan ve beğenilen içerikler</p>
        </div>

        <div class="row">
            @if (ViewBag.PopularPosts != null)
            {
                foreach (var popularPost in ViewBag.PopularPosts as List<PostListDTO>)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card post-card border-0 shadow-hover h-100" data-post-id="@popularPost.Id">
                            <img src="@popularPost.FeaturedImage" class="card-img-top" style="height:250px; object-fit:cover;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <a href="@Url.Action("Details", "Home", new { area = "User", slug = popularPost.Slug })">
                                        @popularPost.Title
                                    </a>
                                </h5>
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="d-flex justify-content-between text-muted">
                                    <span>
                                        <i class="far fa-eye"></i>
                                        <span id="view-count-@popularPost.Id">@popularPost.ViewCount</span>
                                    </span>

                                    <!-- Beğeni Butonu -->
                                    <span class="like-btn" onclick="toggleLike('@popularPost.Id')" style="cursor:pointer;">
                                        <i class="@(popularPost.IsLiked ? "fas liked" : "far") fa-heart like-icon" id="like-icon-@popularPost.Id"></i>
                                        <span id="like-count-@popularPost.Id">@popularPost.LikeCount</span>
                                    </span>

                                    <span>
                                        <i class="far fa-comment-alt"></i>
                                        @popularPost.CommentCount
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>



<!-- ================= ÖNE ÇIKAN YAZILAR ================= -->
<section class="featured-posts pt-0">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title display-5 mb-3">Öne Çıkan Yazılar</h2>
            <div class="divider mx-auto"></div>
            <p class="lead text-muted">En çok okunan ve beğenilen içerikler</p>
        </div>

        <div class="row">
            @if (Model != null && Model.Items.Any())
            {
                foreach (var post in Model.Items)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card post-card h-100 border-0 shadow-hover" data-post-id="@post.Id">
                            <div class="card-img-top position-relative">
                                <a href="@Url.Action("Details", "Home", new { area = "User", id = post.Id })">
                                    <img src="@post.FeaturedImage" class="card-img-top" alt="@post.Title" style="height:250px; object-fit:cover;">
                                </a>
                                <div class="card-meta" style="position:absolute; top:15px; left:15px; right:15px; display:flex; justify-content:space-between;">
                                    <span class="meta-category">@post.CategoryName</span>
                                    <span class="meta-date">@post.CreatedDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="card-body" style="flex:1;">
                                <h3 class="card-title">
                                    <a href="@Url.Action("Details", "Home", new { area = "User", id = post.Id })" class="text-dark hover-primary">
                                        @post.Title
                                    </a>
                                </h3>
                                <p class="card-text text-muted">@post.Excerpt</p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <div class="post-author d-flex align-items-center mb-3">
                                    <div class="ml-3">
                                        <h6 class="mb-0">@post.FullName</h6>
                                        <small class="text-muted">Yazar</small>
                                    </div>
                                </div>
                                <div class="post-stats d-flex align-items-center mb-3">
                                    <span class="stat-item mr-3">
                                        <i class="far fa-eye"></i>
                                        <span id="view-count-@post.Id">@post.ViewCount</span>
                                    </span>
                                    <span class="stat-item mr-3">
                                        <i class="far fa-comment-alt"></i> @post.CommentCount
                                    </span>
                                    <span class="like-btn" onclick="toggleLike('@post.Id')" style="cursor:pointer;">
                                        <i class="@(post.IsLiked ? "fas liked" : "far") fa-heart like-icon" id="like-icon-@post.Id"></i>
                                        <span id="like-count-@post.Id">@post.LikeCount</span>
                                    </span>
                                </div>
                                <a asp-area="User"
                                   asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-slug="@post.Slug"
                                   class="btn btn-primary py-2">
                                    Devamını Oku <span class="ion-ios-arrow-forward"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-blog fa-4x text-muted mb-4"></i>
                        <h4 class="mb-3">Henüz içerik yok</h4>
                        <p class="text-muted">Bu kategoride henüz yayınlanmış yazı bulunmamaktadır.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageIndex - 1 })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i })">@i</a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageIndex + 1 })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</section>

<style>
    /* Carousel Stilleri */
    .carousel-item {
        height: 600px;
    }

    .carousel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
    }

    .carousel-caption {
        bottom: 30%;
    }

    .circle-indicators li {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin: 0 8px;
    }

    /* Kart Stilleri */
    .post-card {
        transition: transform 0.3s, box-shadow 0.3s;
        border-radius: 15px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .post-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

    .card-img-top {
        height: 250px;
        object-fit: cover;
    }

    .card-meta {
        position: absolute;
        top: 15px;
        left: 15px;
        right: 15px;
        display: flex;
        justify-content: space-between;
    }

    .meta-category {
        background: rgba(255,255,255,0.9);
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: 500;
    }

    .btn-read-more {
        background: linear-gradient(45deg, #6c5ce7, #a66efa);
        border: none;
        border-radius: 25px;
        padding: 0.5rem 1.5rem;
        color: white !important;
        transition: all 0.3s;
    }

        .btn-read-more:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108,92,231,0.3);
        }

    .like-icon.liked {
        color: #dc3545 !important; /* Kırmızı */
    }

    .author-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .divider {
        width: 80px;
        height: 3px;
        background: #6c5ce7;
        margin: 1rem auto;
    }

    .post-stats {
        display: flex;
        gap: 20px;
        margin-top: 15px;
    }
    /* Autocomplete sonuçları için özel stil */
    #autocompleteList {
        max-height: 400px;
        overflow-y: auto;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        border-radius: 8px;
    }

        #autocompleteList a {
            transition: all 0.2s;
            border-bottom: 1px solid #eee;
        }

            #autocompleteList a:hover {
                background: #f8f9fa;
                transform: translateX(5px);
            }

        #autocompleteList img {
            border: 2px solid #6c5ce7;
            padding: 2px;
        }

        #autocompleteList h6 {
            color: #2d3436;
            font-weight: 600;
        }

        #autocompleteList .text-muted {
            font-size: 0.85em;
        }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<script>
    /* ==========================
       GÖRÜNTÜLENME (ViewCount) ARTIR
    ========================== */
    $(document).on('click', '.post-card a', function () {
        const postId = $(this).closest('.post-card').data('post-id');
        if (postId && !sessionStorage.getItem('viewed_' + postId)) {
            sessionStorage.setItem('viewed_' + postId, 'true');
      
        }
    });

     function increaseViewCount(postId) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("IncreaseViewCount", "Home", new { area = "User" })",
            data: { postId: postId },
            success: function (response) {
                if (response.success) {
                    let viewCountElement = $('#view-count-' + postId);
                    let newCount = response.viewCount || parseInt(viewCountElement.text()) + 1;
                    viewCountElement.text(newCount);
                }
            }
        });
    }


    /* ==========================
       LIKE BUTONU
    ========================== */
    function likePost(postId) {
        const likeIcon = $('#like-icon-' + postId);
        const likeCount = $('#like-count-' + postId);

        $.ajax({
            type: "POST",
            url: "@Url.Action("LikePost", "Home", new { area = "User" })",
            data: { postId: postId },
            success: function (response) {
                if (response.success) {
                    likeCount.text(response.likeCount);
                    likeIcon.toggleClass('far fas liked');

                    Swal.fire({
                        icon: 'success',
                        title: 'Beğenilenlere eklendi!',
                        showConfirmButton: false,
                        timer: 1500
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: response.message || 'Beğeni işlemi başarısız.'
                    });
                }
            }
        });
    }

    /* ==========================
       CANLI ARAMA (AUTOCOMPLETE)
    ========================== */
    $('#searchQueryInput').on('keyup', function () {
        let query = $(this).val();
        if (query.length < 2) {
            $('#autocompleteList').empty();
            return;
        }

        $.ajax({
            url: '@Url.Action("GetAutocompleteResults", "Home", new { area = "User" })',
            type: 'GET',
            data: { term: query },
            success: function (results) {
                let list = $('#autocompleteList');
                list.empty();

                $.each(results, function (i, item) {
                    list.append(`
                        <a href="Details/${item.slug}"
                           class="list-group-item list-group-item-action d-flex align-items-center">
                            <img src="${item.image}"
                                 class="mr-3 rounded"
                                 style="width:50px; height:50px; object-fit:cover;">
                            <div>
                                <h6 class="mb-1">${item.title}</h6>
                                <small class="text-muted">
                                    <i class="fas fa-tag"></i> ${item.category} •
                                    ${item.date}
                                </small>
                            </div>
                        </a>
                    `);
                });
            }
        });
    });

    $(document).ready(function () {
        // Sayfa yüklenince beğenilen postları işaretle
        markLikedPosts();
    });

    // **BEĞENİ İŞLEMİ**
    function toggleLike(postId) {
        const likeIcon = $('#like-icon-' + postId);
        const likeCount = $('#like-count-' + postId);

        $.ajax({
            type: "POST",
            url: "/User/Home/ToggleLike",
            data: { postId: postId },
            success: function (response) {
                if (response.success) {
                    likeCount.text(response.likeCount);

                    if (response.isLiked) {
                        likeIcon.removeClass('far').addClass('fas liked'); // Kırmızı kalp
                        saveLikedPost(postId); // LocalStorage'a kaydet
                    } else {
                        likeIcon.removeClass('fas liked').addClass('far'); // Boş kalp
                        removeLikedPost(postId); // LocalStorage'dan sil
                    }

                    Swal.fire({
                        icon: response.isLiked ? 'success' : 'info',
                        title: response.isLiked ? 'Beğenildi!' : 'Beğeni kaldırıldı!',
                        showConfirmButton: false,
                        timer: 1500
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: response.message || 'Beğeni işlemi başarısız.'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Bağlantı Hatası!',
                    text: 'Sunucuya bağlanılamadı, lütfen internet bağlantınızı kontrol edin.'
                });
            }
        });
    }

    // **Beğenilen Postları Kaydet (LocalStorage)**
    function saveLikedPost(postId) {
        let likedPosts = JSON.parse(localStorage.getItem("likedPosts")) || [];
        if (!likedPosts.includes(postId)) {
            likedPosts.push(postId);
            localStorage.setItem("likedPosts", JSON.stringify(likedPosts));
        }
    }

    // **Beğenilen Postları Sil (LocalStorage)**
    function removeLikedPost(postId) {
        let likedPosts = JSON.parse(localStorage.getItem("likedPosts")) || [];
        likedPosts = likedPosts.filter(id => id !== postId);
        localStorage.setItem("likedPosts", JSON.stringify(likedPosts));
    }

    // **Sayfa Yüklenirken Beğenilenleri İşaretle**
    function markLikedPosts() {
        let likedPosts = JSON.parse(localStorage.getItem("likedPosts")) || [];
        likedPosts.forEach(postId => {
            let likeIcon = $('#like-icon-' + postId);
            if (likeIcon.length) {
                likeIcon.removeClass('far').addClass('fas liked'); // Beğenilmiş olanları kırmızı yap
            }
        });
    }


</script>


