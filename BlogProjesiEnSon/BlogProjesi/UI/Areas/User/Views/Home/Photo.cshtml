@model List<Business.DTOs.PhotoDTOs.PhotoListDTO>

@{
    Layout = "_UserLayout";
    ViewBag.Title = "Galeri";
}

<!-- FSLightbox CSS yok, sadece JS yeterli -->

<style>
    .photo-gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .photo-card {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        width: 280px;
        height: 220px;
        transition: all 0.3s ease;
    }

        .photo-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
            border-radius: 8px;
        }

        .photo-card:hover img {
            transform: scale(1.05);
        }

    .photo-info {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 15px;
        background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
        color: #fff;
        font-size: 14px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .photo-card:hover .photo-info {
        opacity: 1;
    }

    @@media (max-width: 768px) {
        .photo-card {
            height: 180px;
            width: 90%;
        }

        .photo-info {
            font-size: 12px;
            padding: 10px;
        }
    }

    .no-photos {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 40px;
        text-align: center;
        font-size: 18px;
        color: #555;
        margin-top: 50px;
    }
</style>

<div class="container py-5">
    @if (Model == null || !Model.Any())
    {
        <div class="no-photos">
            Henüz fotoğraf eklenmemiş.
        </div>
    }
    else
    {
        <div class="photo-gallery">
            @{
                var index = 1;
            }
            @foreach (var photo in Model)
            {
                <a data-fslightbox="gallery" href="@photo.ImageUrl" class="photo-card">
                    <img src="@photo.ImageUrl" alt="@photo.Title" />
                    <div class="photo-info">
                        <strong>@photo.Title</strong><br />
                        @photo.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                    </div>
                </a>
                index++;
            }
        </div>
    }
</div>

<!-- ✅ FSLightbox JS -->
<script src="https://cdn.jsdelivr.net/npm/fslightbox/index.js"></script>
