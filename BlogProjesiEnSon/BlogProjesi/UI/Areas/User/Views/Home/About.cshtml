@{
    Layout = "_UserLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Hakkımda - Ali</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --accent-color: #17a2b8;
            --dark-bg: #1a1a1a;
            --text-color: #f8f9fa;
        }

        body {
            background: var(--dark-bg);
            color: var(--text-color);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            line-height: 1.6;
        }

        .about-section {
            padding: 4rem 0;
            position: relative;
            overflow: hidden;
        }

        .profile-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .profile-img {
            width: 100%;
            max-width: 280px;
            height: auto;
            border-radius: 15px;
            transform: rotate(3deg);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

            .profile-img:hover {
                transform: rotate(0) scale(1.02);
            }

        .about-content h2 {
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 1.5rem;
            position: relative;
            padding-bottom: 0.5rem;
        }

            .about-content h2:after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 60px;
                height: 3px;
                background: var(--accent-color);
            }

        .info-item {
            margin-bottom: 1.2rem;
            padding-left: 1.5rem;
            position: relative;
        }

            .info-item:before {
                content: "▹";
                position: absolute;
                left: 0;
                color: var(--accent-color);
            }

        .social-links {
            margin-top: 2rem;
        }

            .social-links a {
                width: 45px;
                height: 45px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-right: 1rem;
                transition: all 0.3s ease;
                text-decoration: none;
            }

                .social-links a:hover {
                    background: var(--primary-color);
                    transform: translateY(-3px);
                }

        @@media (max-width: 992px) {
            .profile-img {
                max-width: 220px;
                margin-bottom: 2rem;
            }

            .about-content h2 {
                font-size: 1.8rem;
            }
        }

        @@media (max-width: 768px) {
            .profile-card {
                text-align: center;
            }

            .info-item {
                padding-left: 0;
                text-align: left;
            }

                .info-item:before {
                    display: none;
                }
        }
    </style>
</head>
<body>
    <section class="about-section">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">
                    <div class="profile-img-wrapper">
                        <img src="~/elen-master/images/author.jpg" alt="Ali" class="profile-img">
                    </div>
                </div>

                <div class="col-lg-7 col-md-6">
                    <div class="profile-card">
                        <div class="about-content">
                            <h2>Ali Eruslu</h2>

                            <div class="info-item">
                                <strong>Yaşadığı Yer:</strong> Afyonkarahisar, Türkiye
                            </div>

                            <div class="info-item">
                                <strong>Eğitim:</strong> 22 Mart Üniversitesi - İlahiyat
                            </div>

                            <div class="info-item">
                                <strong>Meslek:</strong> Öğretmen & Teknoloji Meraklısı
                            </div>

                            <p class="mt-4">
                                Merhaba! Ben Ali. Teknoloji ve yazılım dünyasına tutkulu bir eğitimciyim.
                                Web geliştirme ve oyun tasarımı alanlarında kendimi sürekli geliştiriyor,
                                öğrendiklerimi öğrencilerimle paylaşmaktan büyük keyif alıyorum.
                            </p>

                            <div class="social-links">
                                <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
                                <a href="#" class="text-white"><i class="fab fa-facebook"></i></a>
                                <a href="#" class="text-white"><i class="fab fa-linkedin"></i></a>
                                <a href="#" class="text-white"><i class="fab fa-youtube"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>