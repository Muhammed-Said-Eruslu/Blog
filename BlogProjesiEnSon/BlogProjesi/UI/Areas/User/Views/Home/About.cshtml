@{
    Layout = "_UserLayout";
}
<!-- About.cshtml -->
<section class="ftco-section ftco-about-section">
    <div class="container px-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="row align-items-center">
                    <!-- Profil Resmi -->
                    <div class="col-md-5 mb-5 mb-md-0">
                        <div class="profile-img-container text-center">
                            <img src="~/elen-master/images/author.jpg" alt="Ali Eruslu" class="img-fluid profile-img rounded shadow">
                        </div>
                    </div>

                    <!-- Profil Bilgileri -->
                    <div class="col-md-7">
                        <div class="pl-md-5">
                            <!-- Başlık altı çizgili versiyon -->
                            <h2 class="mb-4 position-relative hover-title">
                                Ali Eruslu
                                <span class="title-underline"></span>
                            </h2>

                            <div class="about-info mb-4">
                                <div class="info-item mb-3">
                                    <span class="icon"><i class="fas fa-map-marker-alt"></i></span>
                                    <span class="text">Afyonkarahisar, Türkiye</span>
                                </div>

                                <div class="info-item mb-3">
                                    <span class="icon"><i class="fas fa-graduation-cap"></i></span>
                                    <span class="text">22 Mart Üniversitesi - İlahiyat</span>
                                </div>

                                <div class="info-item mb-4">
                                    <span class="icon"><i class="fas fa-briefcase"></i></span>
                                    <span class="text">Öğretmen & Teknoloji Meraklısı</span>
                                </div>

                                <p class="mb-4">
                                    Merhaba! Ben Ali. Teknoloji ve yazılım dünyasına tutkulu bir eğitimciyim.
                                    Web geliştirme ve oyun tasarımı alanlarında kendimi sürekli geliştiriyor,
                                    öğrendiklerimi öğrencilerimle paylaşmaktan büyük keyif alıyorum.
                                </p>
                            </div>

                            <!-- Sosyal Medya -->
                            <div class="social-links">
                                <a href="#" class="social-icon"><i class="fab fa-linkedin"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-github"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ftco-about-section {
        background: #fff;
        padding: 5rem 0;
        color: #333;
    }

    .profile-img {
        width: 320px; /* Sabit genişlik */
        height: 320px; /* Sabit yükseklik */
        object-fit: cover; /* Resmin oranlarını korur */
        border-radius: 10px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        transform: rotate(-5deg);
        transition: transform 0.4s ease;
    }

        .profile-img:hover {
            transform: rotate(0deg);
        }

    /* Başlık ve çizgi efekti */
    .hover-title {
        display: inline-block;
        cursor: default;
    }

    .title-underline {
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 40px;
        height: 2px;
        background: #6c5ce7;
        transition: all 0.4s ease;
    }

    .hover-title:hover .title-underline {
        width: 120px;
    }

    .about-info .info-item {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }

    .about-info .icon {
        width: 30px;
        color: #6c5ce7;
        font-size: 1.1rem;
    }

    .social-links {
        margin-top: 2rem;
    }

    .social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #6c5ce7;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.75rem;
        transition: all 0.3s ease;
    }

        .social-icon:hover {
            background: #5649c0;
            transform: translateY(-3px);
        }

    /* Mobil Uyumluluk */
    @@media (max-width: 992px) {
        .ftco-about-section {
            padding: 4rem 0;
        }

        .profile-img {
            width: 280px;
            height: 280px;
            margin: 0 auto 2rem;
        }
    }

    @@media (max-width: 768px) {
        .ftco-about-section {
            padding: 3rem 0;
        }

        .profile-img {
            width: 260px;
            height: 260px;
            transform: rotate(-5deg); /* Mobilde de çapraz */
        }

            .profile-img:hover {
                transform: rotate(0deg); /* Mobilde hover efekti */
            }

        .pl-md-5 {
            padding-left: 0 !important;
            text-align: center;
        }

        .about-info .info-item {
            justify-content: center;
        }

        .hover-title:hover .title-underline {
            width: 60px;
            left: 50%;
            transform: translateX(-50%);
        }

        .title-underline {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 576px) {
        .profile-img {
            width: 240px;
            height: 240px;
        }

        .social-icon {
            width: 36px;
            height: 36px;
            margin-right: 0.5rem;
        }
    }
</style>