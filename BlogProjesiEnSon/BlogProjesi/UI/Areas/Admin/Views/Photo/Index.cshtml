@model List<Business.DTOs.PhotoDTOs.PhotoListDTO>
@{
    ViewData["Title"] = "Fotoğraf Yönetimi";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <style>
        :root {
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --info-color: #00cfe8;
            --success-color: #28c76f;
            --border-color: #e0e0e0; /* Lighter border color */
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
            background-color: white; /* Ensure card is white */
        }

        .card-header {
            background-color: white;
            border-bottom: 1px solid var(--border-color);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .card-title {
            font-weight: 600;
            color: #333; /* Darker text for better contrast */
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

            .card-title i {
                margin-right: 10px;
                font-size: 1.5rem;
                color: #555; /* Slightly darker icon color */
            }

        .card-body {
            padding: 2rem;
            background-color: white; /* Ensure body is white */
        }

        /* White table styling */
        .table {
            background-color: white;
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }

            .table th {
                background-color: #f9f9f9; /* Very light gray for header */
                color: #333;
                font-weight: 600;
                padding: 1rem;
                border-bottom: 2px solid var(--border-color);
                border-top: none;
            }

            .table td {
                padding: 1rem;
                border-bottom: 1px solid var(--border-color);
                vertical-align: middle;
                background-color: white;
                color: #555;
            }

        .table-hover tbody tr:hover td {
            background-color: #f8f8f8; /* Slightly darker on hover */
        }

        /* Rest of your existing styles... */
        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.75rem 1.5rem;
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
        }

            .btn i {
                margin-right: 0.5rem;
                font-size: 1.1rem;
            }

        .btn-success {
            background-color: var(--success-color);
            color: white;
        }

            .btn-success:hover {
                background-color: #1da15a;
                transform: translateY(-2px);
            }

        .btn-info {
            background-color: var(--info-color);
            color: white;
        }

            .btn-info:hover {
                background-color: #00a1b5;
                transform: translateY(-2px);
            }

        .btn-warning {
            background-color: var(--warning-color);
            color: white;
        }

            .btn-warning:hover {
                background-color: #ff851a;
                transform: translateY(-2px);
            }

        .btn-danger {
            background-color: var(--danger-color);
            color: white;
        }

            .btn-danger:hover {
                background-color: #e42728;
                transform: translateY(-2px);
            }

        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .photo-thumbnail {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
            transition: var(--transition);
            border: 1px solid var(--border-color);
        }

            .photo-thumbnail:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 12px 0 rgba(34, 41, 47, 0.15);
            }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .action-buttons {
                flex-direction: column;
                gap: 0.5rem;
            }

            .btn {
                width: 100%;
            }

            .photo-thumbnail {
                width: 80px;
                height: 80px;
            }
        }

        /* Remove dark mode or adjust for white theme */
        @@media (prefers-color-scheme: dark) {
            body {
                background-color: #f5f5f9; /* Keep light background */
            }

            .card, .card-header {
                background-color: white; /* Keep white cards */
                color: #333; /* Dark text */
            }

            .card-title {
                color: #333; /* Dark text */
            }

            .photo-thumbnail {
                border-color: #e0e0e0; /* Light border */
            }

            .table th,
            .table td {
                background-color: white;
                color: #555;
            }
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">
            <i class="mdi mdi-image-multiple"></i>@ViewData["Title"]
        </h4>
        <a asp-action="Create" class="btn btn-success">
            <i class="mdi mdi-plus"></i> Yeni Fotoğraf
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="photoTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Fotoğraf</th>
                        <th>Oluşturulma</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>
                                <img src="@item.ImageUrl" class="photo-thumbnail" alt="@item.Title" />
                            </td>
                            <td>
                                <span class="badge bg-light-secondary">
                                    @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                        <i class="mdi mdi-eye"></i> Detay
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        <i class="mdi mdi-pencil"></i> Düzenle
                                    </a>
                                    <button class="btn btn-danger btn-sm delete-btn" data-id="@item.Id">
                                        <i class="mdi mdi-delete"></i> Sil
                                    </button>
                                </div>
                                <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:none;"></form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable with responsive extension
            $('#photoTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json'
                },
                columnDefs: [
                    { orderable: false, targets: [1, 3] },
                    { searchable: false, targets: [1, 3] }
                ]
            });

            // Delete button handler
            $('.delete-btn').click(function () {
                var photoId = $(this).data('id');
                var photoTitle = $(this).closest('tr').find('td:first').text();

                Swal.fire({
                    title: 'Emin misiniz?',
                    html: `<b>"${photoTitle}"</b> başlıklı fotoğraf silinecek!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ea5455',
                    cancelButtonColor: '#7367f0',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'Vazgeç',
                    reverseButtons: true,
                    customClass: {
                        confirmButton: 'btn btn-danger me-2',
                        cancelButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading indicator
                        Swal.fire({
                            title: 'Siliniyor...',
                            html: 'Fotoğraf siliniyor, lütfen bekleyin.',
                            timer: 2000,
                            timerProgressBar: true,
                            didOpen: () => {
                                Swal.showLoading();
                            },
                            willClose: () => {
                                $('#delete-form-' + photoId).submit();
                            }
                        });
                    }
                });
            });
        });
    </script>
}