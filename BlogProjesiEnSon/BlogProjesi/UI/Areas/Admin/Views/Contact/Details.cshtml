@model Domain.Entites.Contact

@{
    ViewData["Title"] = "Mesaj Detayları";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root {
            --primary-color: #7367f0;
            --secondary-color: #82868b;
            --info-color: #00cfe8;
            --border-color: #d8d6de;
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-weight: 600;
            color: #5e5873;
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

            .card-title i {
                margin-right: 10px;
                font-size: 1.5rem;
            }

        .card-body {
            padding: 2rem;
        }

        .detail-list {
            margin-bottom: 2rem;
        }

            .detail-list dt {
                font-weight: 600;
                color: #5e5873;
                padding: 0.75rem 0;
                border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            }

            .detail-list dd {
                padding: 0.75rem 0;
                border-bottom: 1px solid rgba(34, 41, 47, 0.05);
                margin-left: 0;
                word-break: break-word;
            }

            .detail-list dt.col-sm-2 {
                width: 200px;
            }

            .detail-list dd.col-sm-10 {
                width: calc(100% - 200px);
            }

        .message-content {
            white-space: pre-line;
            background-color: #f8f8f8;
            padding: 1rem;
            border-radius: 6px;
            border-left: 3px solid var(--info-color);
        }

        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.75rem 1.5rem;
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
        }

            .btn i {
                margin-right: 0.5rem;
                font-size: 1.1rem;
            }

        .btn-secondary {
            background-color: var(--secondary-color);
            color: white;
        }

            .btn-secondary:hover {
                background-color: #6c757d;
                transform: translateY(-2px);
            }

        .btn-info {
            background-color: var(--info-color);
            color: white;
        }

            .btn-info:hover {
                background-color: #00a1b5;
                transform: translateY(-2px);
            }

        .badge {
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
        }

        .badge-light-primary {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-body {
                padding: 1.5rem;
            }

            .detail-list dt.col-sm-2,
            .detail-list dd.col-sm-10 {
                width: 100%;
            }

            .detail-list dt {
                padding-top: 1rem;
                border-bottom: none;
            }

            .detail-list dd {
                padding-top: 0.25rem;
                padding-bottom: 1rem;
                margin-bottom: 0.5rem;
            }

            .action-buttons {
                flex-direction: column;
                gap: 0.75rem;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">
            <i class="mdi mdi-email-open"></i>@ViewData["Title"]
        </h4>
        <div class="badge badge-light-primary">
            <i class="mdi mdi-clock-outline me-1"></i>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>
    <div class="card-body">
        <dl class="row detail-list">
            <dt class="col-sm-2">Gönderen:</dt>
            <dd class="col-sm-10">
                <div class="d-flex align-items-center">
                    <div class="badge badge-light-primary rounded-pill me-3" style="min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="mdi mdi-account-outline fs-5"></i>
                    </div>
                    <div>
                        <span class="fw-semibold">@Model.FullName</span>
                        <div class="text-muted small mt-1">
                            <a href="mailto:@Model.Email" class="text-primary">@Model.Email</a>
                        </div>
                    </div>
                </div>
            </dd>

            <dt class="col-sm-2">Konu:</dt>
            <dd class="col-sm-10">
                <span class="fw-semibold">@Model.Subject</span>
            </dd>

            <dt class="col-sm-2">Mesaj:</dt>
            <dd class="col-sm-10">
                <div class="message-content">
                    @Model.Message
                </div>
            </dd>

            <dt class="col-sm-2">İletişim Bilgileri:</dt>
            <dd class="col-sm-10">
                <div class="d-flex flex-wrap gap-2">
                    <a href="mailto:@Model.Email" class="btn btn-sm btn-info">
                        <i class="mdi mdi-email-outline"></i> Email Gönder
                    </a>
                
                </div>
            </dd>
        </dl>

        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="mdi mdi-arrow-left"></i> Listeye Dön
            </a>
            <button type="button" class="btn btn-danger" id="deleteButton">
                <i class="mdi mdi-delete"></i> Mesajı Sil
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $('#deleteButton').on('click', function() {
                Swal.fire({
                    title: 'Emin misiniz?',
                    html: `<b>@Model.FullName</b> adlı kişinin mesajı silinecek. Bu işlem geri alınamaz!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal',
                    confirmButtonColor: '#ea5455',
                    cancelButtonColor: '#7367f0',
                    reverseButtons: true,
                    customClass: {
                        confirmButton: 'btn btn-danger me-2',
                        cancelButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Formu oluştur ve gönder
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '@Url.Action("Delete", "Contact", new { area = "Admin" })'; // Yönlendirme doğru mu?

                        const hiddenField = document.createElement('input');
                        hiddenField.type = 'hidden';
                        hiddenField.name = 'id'; // Parametre adı "id"
                        hiddenField.value = '@Model.Id'; // Model id değeri

                        // CSRF Token'ı ekle
                        const token = document.createElement('input');
                        token.type = 'hidden';
                        token.name = '__RequestVerificationToken';
                        token.value = $('input[name="__RequestVerificationToken"]').val(); // CSRF token'ı

                        form.appendChild(hiddenField);
                        form.appendChild(token);
                        document.body.appendChild(form);

                        // Gönderim işlemi
                        Swal.fire({
                            title: 'Siliniyor...',
                            html: 'Mesaj siliniyor, lütfen bekleyin.',
                            timer: 2000,
                            timerProgressBar: true,
                            didOpen: () => {
                                Swal.showLoading();
                            },
                            willClose: () => {
                                form.submit();
                            }
                        });
                    }
                });
            });
        });
    </script>
}