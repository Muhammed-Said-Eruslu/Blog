@model Domain.Entites.Contact

@{
    ViewData["Title"] = "Mesaj Detayları";
    Layout = "_AdminLayout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Mesaj Detayları</h6>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">
                Ad Soyad
            </dt>
            <dd class="col-sm-10">
                @Model.FullName
            </dd>
            <dt class="col-sm-2">
                Email
            </dt>
            <dd class="col-sm-10">
                @Model.Email
            </dd>
            <dt class="col-sm-2">
                Konu
            </dt>
            <dd class="col-sm-10">
                @Model.Subject
            </dd>
            <dt class="col-sm-2">
                Mesaj
            </dt>
            <dd class="col-sm-10">
                @Model.Message
            </dd>
            <dt class="col-sm-2">
                Tarih
            </dt>
            <dd class="col-sm-10">
                @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </dd>
        </dl>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        </div>
    </div>
</div>