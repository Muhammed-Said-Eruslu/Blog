@model List<Domain.Entites.Contact>

@{
    ViewData["Title"] = "İletişim Mesajları";
    Layout = "_AdminLayout";
}

<!-- SweetAlert CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">İletişim Mesajları</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Email</th>
                        <th>Konu</th>
                        <th>Mesaj</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model)
                    {
                        <tr>
                            <td>@contact.FullName</td>
                            <td>@contact.Email</td>
                            <td>@contact.Subject</td>
                            <td>@(contact.Message.Length > 50 ? contact.Message.Substring(0, 50) + "..." : contact.Message)</td>
                            <td>@contact.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = contact.Id })" class="btn btn-info btn-sm">Detay</a>
                                <button onclick="deleteContact('@contact.Id')" class="btn btn-danger btn-sm">Sil</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SweetAlert JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteContact(contactId) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu mesajı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                // Form oluştur ve gönder
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", "Contact", new { area = "Admin" })';

                const hiddenField = document.createElement('input');
                hiddenField.type = 'hidden';
                hiddenField.name = 'id';
                hiddenField.value = contactId;

                form.appendChild(hiddenField);
                document.body.appendChild(form);
                form.submit();

                // Silme işlemi başladığında loading göster
                Swal.fire({
                    title: 'Siliniyor...',
                    html: 'Mesaj siliniyor, lütfen bekleyin.',
                    timer: 2000,
                    timerProgressBar: true,
                    didOpen: () => {
                        Swal.showLoading()
                    }
                });
            }
        });
    }
</script>