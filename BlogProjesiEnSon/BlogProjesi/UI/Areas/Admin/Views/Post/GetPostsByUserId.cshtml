@model IEnumerable<Business.DTOs.PostDTOs.PostListDTO>
@{
    ViewBag.Title = "Yazara Göre Yazılar";
    Layout = "_AdminLayout";
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı',
                    text: '@TempData["SuccessMessage"]'
                });
            </text>
        }
    </script>
}

<h2>Yazara Göre Yazılar</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>URL</th>
            <th>Kategori</th>
            <th>Yazar</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Title</td>
                <td>@post.VideoUrl</td>
                <td>@post.CategoryName</td>
                <td>@post.UserId</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = post.Id })" class="btn btn-primary">Düzenle</a>
                    <a href="@Url.Action("GetPostDetails", new { postId = post.Id })" class="btn btn-info">Detaylar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
