@model Business.DTOs.PostDTOs.PostDetailDTO
@{
    ViewBag.Title = "Yazı Detayları";
    Layout = "_AdminLayout";
}
<!-- Bootstrap CSS (versiyon 5) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .post-detail {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .post-image {
        max-height: 500px;
        object-fit: cover;
        width: 100%;
    }

    .video-player iframe,
    .video-player video {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .post-meta p {
        margin-bottom: 5px;
    }
</style>

<div class="container my-5">
    <a href="javascript:history.back()" class="btn btn-secondary mb-3">&#8592; Geri Git</a>

    @if (Model == null)
    {
        <div class="alert alert-warning mt-4">Yazı bulunamadı.</div>
    }
    else
    {
        <div class="post-detail card">
            <div class="card-header text-center">
                <h2 class="mb-0">Başlık: @Model.Title</h2>
            </div>
            <div class="card-body">
                @* Görsel Alanı *@
                @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.FeaturedImage" alt="@Model.Title" class="post-image img-fluid">
                    </div>
                }

                @* Video Alanı *@
                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="video-player mb-4">
                        @if (Model.VideoUrl.Contains("youtube.com") || Model.VideoUrl.Contains("youtu.be"))
                        {
                            var embedUrl = "";
                            if (Model.VideoUrl.Contains("youtube.com/watch?v="))
                            {
                                embedUrl = Model.VideoUrl.Replace("watch?v=", "embed/");
                            }
                            else if (Model.VideoUrl.Contains("youtu.be"))
                            {
                                embedUrl = Model.VideoUrl.Replace("youtu.be/", "www.youtube.com/embed/");
                            }
                            <div class="ratio ratio-16x9">
                                <iframe src="@embedUrl" frameborder="0" allowfullscreen></iframe>
                            </div>
                        }
                        else if (Model.VideoUrl.Contains("vimeo.com"))
                        {
                            var vimeoId = Model.VideoUrl.Split('/').Last();
                            <div class="ratio ratio-16x9">
                                <iframe src="https://player.vimeo.com/video/@vimeoId" frameborder="0" allowfullscreen></iframe>
                            </div>
                        }
                        else
                        {
                            <video width="100%" controls>
                                <source src="@Model.VideoUrl" type="video/mp4">
                                Tarayıcınız video etiketini desteklemiyor.
                            </video>
                        }
                    </div>
                }

                @* İçerik Alanı (Collapse) *@
                <div class="post-content mb-4">
                    <h5>
                        <a class="btn btn-outline-secondary" data-bs-toggle="collapse" href="#contentCollapse" role="button" aria-expanded="false" aria-controls="contentCollapse">
                            İçerik (tıklayarak aç/kapa)
                        </a>
                    </h5>
                    <div class="collapse" id="contentCollapse">
                        <div class="mt-3">
                            @Html.Raw(Model.Content)
                        </div>
                    </div>
                </div>

                <hr />

                @* Meta Bilgiler *@
                <div class="post-meta mb-4">
                    <h5>Meta Bilgiler</h5>
                    <p><strong>Kategori:</strong> @Model.CategoryName</p>
                    <p><strong>Yazar:</strong> @(string.IsNullOrEmpty(Model.AuthorName) ? "Bilinmiyor" : Model.AuthorName)</p>

                    <p><strong>Oluşturulma Tarihi:</strong> @Model.CreatedAt.ToShortDateString()</p>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <p><strong>Güncellenme Tarihi:</strong> @Model.UpdatedAt.Value.ToShortDateString()</p>
                    }
                </div>

                @* Yorumlar Bölümü (Collapse) *@
                <div class="post-comments mb-4">
                    <h5>
                        <a class="btn btn-outline-primary" data-bs-toggle="collapse" href="#commentsCollapse" role="button" aria-expanded="false" aria-controls="commentsCollapse">
                            Yorumlar (@(Model.Comments != null ? Model.Comments.Count() : 0))
                        </a>
                    </h5>
                    <div class="collapse" id="commentsCollapse">
                        <div class="card card-body">
                            @if (Model.Comments != null && Model.Comments.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var comment in Model.Comments)
                                    {
                                        <li class="list-group-item">
                                            <p class="mb-0">@comment.Content</p>
                                            <small class="text-muted">- @comment.AuthorName</small>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>Yorum yok.</p>
                            }
                        </div>
                    </div>
                </div>

                @* Etiketler *@
                <div class="post-tags mb-4">
                    <h5>Etiketler</h5>
                    @if (Model.Tags != null && Model.Tags.Any())
                    {
                        foreach (var tag in Model.Tags)
                        {
                            <span class="badge bg-info text-dark me-1 mb-1">@tag.TagName</span>
                        }
                    }
                    else
                    {
                        <p>Etiket yok.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Bootstrap JS Bundle (dahil popper.js) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
