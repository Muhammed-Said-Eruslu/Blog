@model Business.DTOs.PostDTOs.PostDetailDTO
@{
    ViewBag.Title = "Yazı Detayları";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root {
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --info-color: #00cfe8;
            --success-color: #28c76f;
            --border-color: #d8d6de;
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .post-detail {
            background: #fff;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            border: none;
        }

        .post-image {
            max-height: 500px;
            object-fit: cover;
            width: 100%;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .video-container {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 aspect ratio */
            height: 0;
            overflow: hidden;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .video-container iframe,
            .video-container video {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border: none;
            }

        .post-meta p {
            margin-bottom: 0.5rem;
            color: #5e5873;
        }

        .post-meta strong {
            color: #5e5873;
            min-width: 150px;
            display: inline-block;
        }

        .badge-tag {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
            display: inline-block;
        }

        .comment-item {
            border-left: 3px solid var(--primary-color);
            padding-left: 1rem;
            margin-bottom: 1rem;
        }

        .comment-author {
            font-weight: 600;
            color: var(--primary-color);
        }

        .comment-date {
            font-size: 0.8rem;
            color: #6e6b7b;
        }

        .btn-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            text-align: left;
        }

            .btn-toggle:after {
                content: '\f078';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                transition: var(--transition);
            }

            .btn-toggle[aria-expanded="true"]:after {
                transform: rotate(180deg);
            }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
        }

        .card-body {
            padding: 2rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-body {
                padding: 1.5rem;
            }

            .post-meta strong {
                min-width: 120px;
            }
        }
    </style>
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-file-earmark-text me-2"></i>@ViewBag.Title
                </h2>
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri Dön
                </a>
            </div>

            @if (Model == null)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>Yazı bulunamadı.
                </div>
            }
            else
            {
                <div class="post-detail card">
                    <div class="card-header">
                        <h3 class="mb-0">@Model.Title</h3>
                    </div>
                    <div class="card-body">
                        <!-- Görsel Alanı -->
                        @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                        {
                            <div class="text-center mb-4">
                                <img src="@Model.FeaturedImage" alt="@Model.Title" class="post-image img-fluid">
                            </div>
                        }

                        <!-- Video Alanı -->
                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <div class="mb-4">
                                <h5 class="mb-3">
                                    <i class="bi bi-play-circle me-2"></i>Video İçeriği
                                </h5>
                                <div class="video-container">
                                    @if (Model.VideoUrl.Contains("youtube.com") || Model.VideoUrl.Contains("youtu.be"))
                                    {
                                        var embedUrl = "";
                                        if (Model.VideoUrl.Contains("youtube.com/watch?v="))
                                        {
                                            embedUrl = Model.VideoUrl.Replace("watch?v=", "embed/");
                                        }
                                        else if (Model.VideoUrl.Contains("youtu.be"))
                                        {
                                            embedUrl = Model.VideoUrl.Replace("youtu.be/", "www.youtube.com/embed/");
                                        }
                                        <iframe src="@embedUrl" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    }
                                    else if (Model.VideoUrl.Contains("vimeo.com"))
                                    {
                                        var vimeoId = Model.VideoUrl.Split('/').Last();
                                        <iframe src="https://player.vimeo.com/video/@vimeoId" allowfullscreen></iframe>
                                    }
                                    else
                                    {
                                        <video controls>
                                            <source src="@Model.VideoUrl" type="video/mp4">
                                            Tarayıcınız video etiketini desteklemiyor.
                                        </video>
                                    }
                                </div>
                            </div>
                        }

                        <!-- İçerik Alanı -->
                        <div class="mb-4">
                            <div class="accordion" id="contentAccordion">
                                <div class="accordion-item border-0">
                                    <h2 class="accordion-header" id="contentHeading">
                                        <button class="accordion-button btn-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contentCollapse" aria-expanded="false" aria-controls="contentCollapse">
                                            <i class="bi bi-text-paragraph me-2"></i>İçerik
                                        </button>
                                    </h2>
                                    <div id="contentCollapse" class="accordion-collapse collapse" aria-labelledby="contentHeading" data-bs-parent="#contentAccordion">
                                        <div class="accordion-body px-0">
                                            @Html.Raw(Model.Content)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Meta Bilgiler -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5 class="mb-3">
                                    <i class="bi bi-info-circle me-2"></i>Yazı Bilgileri
                                </h5>
                                <div class="ps-3">
                                    <p><strong><i class="bi bi-bookmark me-2"></i>Kategori:</strong> @Model.CategoryName</p>
                                    <p><strong><i class="bi bi-person me-2"></i>Yazar:</strong> @(string.IsNullOrEmpty(Model.AuthorName) ? "Bilinmiyor" : Model.AuthorName)</p>
                                    <p><strong><i class="bi bi-calendar-plus me-2"></i>Oluşturulma:</strong> @Model.CreatedAt.ToString("f")</p>
                                    @if (Model.UpdatedAt.HasValue)
                                    {
                                        <p><strong><i class="bi bi-calendar-check me-2"></i>Güncellenme:</strong> @Model.UpdatedAt.Value.ToString("f")</p>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h5 class="mb-3">
                                    <i class="bi bi-tags me-2"></i>Etiketler
                                </h5>
                                @if (Model.Tags != null && Model.Tags.Any())
                                {
                                    <div class="d-flex flex-wrap ps-3">
                                        @foreach (var tag in Model.Tags)
                                        {
                                            <span class="badge-tag">
                                                <i class="bi bi-tag me-1"></i>@tag.TagName
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted ps-3">Etiket eklenmemiş</p>
                                }
                            </div>
                        </div>

                        <!-- Yorumlar -->
                        <div class="mb-4">
                            <div class="accordion" id="commentsAccordion">
                                <div class="accordion-item border-0">
                                    <h2 class="accordion-header" id="commentsHeading">
                                        <button class="accordion-button btn-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#commentsCollapse" aria-expanded="false" aria-controls="commentsCollapse">
                                            <i class="bi bi-chat-square-text me-2"></i>Yorumlar (@(Model.Comments?.Count() ?? 0))
                                        </button>
                                    </h2>
                                    <div id="commentsCollapse" class="accordion-collapse collapse" aria-labelledby="commentsHeading" data-bs-parent="#commentsAccordion">
                                        <div class="accordion-body px-0">
                                            @if (Model.Comments != null && Model.Comments.Any())
                                            {
                                                <div class="list-group list-group-flush">
                                                    @foreach (var comment in Model.Comments)
                                                    {
                                                        <div class="list-group-item border-0 px-0 py-3">
                                                            <div class="comment-item">
                                                                <p class="mb-2">@comment.Content</p>
                                                                <div class="d-flex justify-content-between">
                                                                    <span class="comment-author">
                                                                        <i class="bi bi-person-circle me-1"></i>@comment.AuthorName
                                                                    </span>
                                                                    <span class="comment-date">
                                                                        @comment.CreatedAt.ToString("f")
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted">Henüz yorum yapılmamış</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- İşlem Butonları -->
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil-square me-1"></i>Düzenle
                            </a>
                            <button type="button" class="btn btn-danger" id="deleteButton">
                                <i class="bi bi-trash me-1"></i>Sil
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Silme butonu işlemi
            $('#deleteButton').click(function () {
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu yazıyı silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ea5455',
                    cancelButtonColor: '#82868b',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Delete", "Post", new { id = Model?.Id })';
                    }
                });
            });

            // Başarı mesajı gösterimi
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Başarılı',
                            text: '@TempData["SuccessMessage"]',
                            confirmButtonColor: '#7367f0'
                        });
            </text>
        }
        });
    </script>
}