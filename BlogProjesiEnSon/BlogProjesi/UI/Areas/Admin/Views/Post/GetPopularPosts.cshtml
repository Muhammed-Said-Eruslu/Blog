@model IEnumerable<Business.DTOs.PostDTOs.PostListDTO>
@{
    ViewBag.Title = "Popüler Yazılar";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root {
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --info-color: #00cfe8;
            --success-color: #28c76f;
            --border-color: #d8d6de;
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .card-title {
            font-weight: 600;
            color: #5e5873;
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

            .card-title i {
                margin-right: 10px;
                font-size: 1.5rem;
                color: var(--primary-color);
            }

        .badge-light-primary {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            display: flex;
            align-items: center;
        }

        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
        }

        .table {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }

            .table th {
                border-top: none;
                font-weight: 600;
                color: #6e6b7b;
                background-color: #f8f8f8;
                padding: 1rem 1.5rem;
                vertical-align: middle;
                border-bottom: 1px solid var(--border-color);
                white-space: nowrap;
            }

            .table td {
                padding: 1rem 1.5rem;
                vertical-align: middle;
                border-top: 1px solid rgba(34, 41, 47, 0.05);
                word-wrap: break-word;
            }

        .table-hover tbody tr:hover td {
            background-color: #f9f9f9;
        }

        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            box-shadow: none;
            margin: 0.25rem 0;
        }

            .btn i {
                margin-right: 0.5rem;
                font-size: 1rem;
            }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

            .btn-primary:hover {
                background-color: #5d50e6;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px 0 rgba(115, 103, 240, 0.4);
            }

        .btn-info {
            background-color: var(--info-color);
            color: white;
        }

            .btn-info:hover {
                background-color: #00a1b5;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px 0 rgba(0, 207, 232, 0.4);
            }

        .btn-danger {
            background-color: var(--danger-color);
            color: white;
        }

            .btn-danger:hover {
                background-color: #e42728;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px 0 rgba(234, 84, 85, 0.4);
            }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .video-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
        }

            .video-link:hover {
                text-decoration: underline;
            }

        .text-muted {
            color: #b9b9c3 !important;
        }

        .table-row-mobile {
            display: none;
            font-weight: 600;
            color: #6e6b7b;
            margin-right: 0.5rem;
        }

        /* Medium devices (tablets) */
        @@media (max-width: 991.98px) {
            .card-header

        {
            padding: 1.25rem;
        }

        .table th, .table td {
            padding: 0.85rem 1rem;
        }

        .container-fluid {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        }

        /* Small devices (landscape phones) */
        @@media (max-width: 767.98px) {
            .card-header

        {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 1rem;
        }

        .card-title i {
            font-size: 1.25rem;
        }

        .badge-light-primary {
            padding: 0.35rem 0.75rem;
        }

        /* Hide table headers */
        .table thead {
            display: none;
        }

        /* Convert rows to cards */
        .table, .table tbody, .table tr {
            display: block;
            width: 100%;
        }

            .table tbody tr {
                margin-bottom: 1rem;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(34, 41, 47, 0.05);
                border: 1px solid var(--border-color);
                background-color: #fff;
            }

            .table td {
                display: flex;
                padding: 0.75rem 1rem;
                text-align: right;
                justify-content: space-between;
                border-bottom: 1px solid #f1f1f1;
                align-items: center;
            }

                .table td:last-child {
                    border-bottom: none;
                }

        /* Add data labels */
        .table-row-mobile {
            display: block;
            flex-shrink: 0;
        }

        .action-buttons {
            width: 100%;
            justify-content: flex-end;
        }

        }

        /* Extra small devices (phones) */
        @@media (max-width: 575.98px) {
            .card-title

        {
            font-size: 1rem;
        }

        .badge-light-primary {
            font-size: 0.8rem;
        }

        .action-buttons {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
            margin: 0.2rem 0;
        }

        .table td {
            flex-direction: column;
            align-items: flex-start;
            text-align: left;
        }

        .table-row-mobile {
            margin-bottom: 0.4rem;
            width: 100%;
        }

        .video-link {
            margin-top: 0.3rem;
        }

        }
    </style>
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="bi bi-fire"></i> @ViewBag.Title
                    </h4>
                    <div class="badge badge-light-primary">
                        <i class="bi bi-collection me-1"></i>@Model.Count() Yazı
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Başlık</th>
                                    <th>Video</th>
                                    <th>Kategori</th>
                                    <th>Yazar</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var post in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="table-row-mobile">Başlık:</span>
                                            <span>@post.Title</span>
                                        </td>
                                        <td>
                                            <span class="table-row-mobile">Video:</span>
                                            <span>
                                                @if (!string.IsNullOrEmpty(post.VideoUrl))
                                                {
                                                    <a href="@post.VideoUrl" target="_blank" class="video-link">
                                                        <i class="bi bi-play-circle me-1"></i>Video
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Yok</span>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            <span class="table-row-mobile">Kategori:</span>
                                            <span>@post.CategoryName</span>
                                        </td>
                                        <td>
                                            <span class="table-row-mobile">Yazar:</span>
                                            <span>@(post.FullName ?? "Bilinmiyor")</span>
                                        </td>
                                        <td>
                                            <span class="table-row-mobile">İşlemler:</span>
                                            <div class="action-buttons">
                                                <a href="@Url.Action("Edit", new { id = post.Id })" class="btn btn-primary btn-sm">
                                                    <i class="bi bi-pencil"></i> Düzenle
                                                </a>
                                                <a href="@Url.Action("GetPostDetails", new { postId = post.Id })" class="btn btn-info btn-sm">
                                                    <i class="bi bi-info-circle"></i> Detaylar
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Başarı mesajı gösterimi
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Başarılı',
                        text: '@TempData["SuccessMessage"]',
                        confirmButtonColor: '#7367f0'
                    });
            </text>
        }
        });
    </script>
}