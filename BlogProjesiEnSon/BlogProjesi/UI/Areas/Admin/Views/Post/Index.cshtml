@model IEnumerable<Business.DTOs.PostDTOs.PostListDTO>
@{
    ViewData["Title"] = "Yazı Yönetimi";
    Layout = "_AdminLayout";
}
@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <style>
        :root {
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --info-color: #00cfe8;
            --success-color: #28c76f;
            --border-color: #d8d6de;
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .card-title {
            font-weight: 600;
            color: #5e5873;
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

            .card-title i {
                margin-right: 10px;
                font-size: 1.5rem;
            }

        .card-body {
            padding: 2rem;
        }

        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.75rem 1.5rem;
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
        }

            .btn i {
                margin-right: 0.5rem;
                font-size: 1.1rem;
            }

        .btn-success {
            background-color: var(--success-color);
            color: white;
        }

            .btn-success:hover {
                background-color: #1da15a;
                transform: translateY(-2px);
            }

        .btn-info {
            background-color: var(--info-color);
            color: white;
        }

            .btn-info:hover {
                background-color: #00a1b5;
                transform: translateY(-2px);
            }

        .btn-warning {
            background-color: var(--warning-color);
            color: white;
        }

            .btn-warning:hover {
                background-color: #ff851a;
                transform: translateY(-2px);
            }

        .btn-danger {
            background-color: var(--danger-color);
            color: white;
        }

            .btn-danger:hover {
                background-color: #e42728;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #82868b;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #6c757d;
                transform: translateY(-2px);
            }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

            .btn-primary:hover {
                background-color: #5d50e6;
                transform: translateY(-2px);
            }

        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
        }

        .table {
            margin-bottom: 0;
        }

            .table th {
                border-top: none;
                font-weight: 600;
                color: #6e6b7b;
                background-color: #f8f8f8;
                padding: 1rem 1.5rem;
                vertical-align: middle;
            }

            .table td {
                padding: 1rem 1.5rem;
                vertical-align: middle;
                border-top: 1px solid rgba(34, 41, 47, 0.05);
                word-wrap: break-word;
            }

        .table-hover tbody tr:hover td {
            background-color: #f9f9f9;
        }

        .dropdown-menu {
            min-width: 200px;
            border-radius: 6px;
            box-shadow: 0 5px 25px rgba(34, 41, 47, 0.1);
            border: none;
        }

        .dropdown-item {
            padding: 0.5rem 1.5rem;
            display: flex;
            align-items: center;
        }

            .dropdown-item i {
                margin-right: 0.75rem;
                width: 20px;
                text-align: center;
            }

            .dropdown-item.text-danger {
                color: var(--danger-color) !important;
            }

                .dropdown-item.text-danger:hover {
                    background-color: rgba(234, 84, 85, 0.1);
                }

        .badge {
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
        }

        .badge-light-primary {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
        }

        .input-group {
            max-width: 400px;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .card-body {
                padding: 1.5rem;
            }

            .action-buttons {
                flex-direction: column;
                gap: 0.5rem;
            }

            .btn {
                width: 100%;
            }

            .input-group {
                max-width: 100%;
            }

            .table td, .table th {
                padding: 0.75rem;
            }
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">
            <i class="bi bi-file-earmark-text"></i>@ViewData["Title"]
        </h4>
        <div class="badge badge-light-primary">
            <i class="bi bi-collection me-1"></i>@Model.Count() Yazı
        </div>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Yeni Yazı
            </a>
            <a asp-action="GetPostStatistics" class="btn btn-info">
                <i class="bi bi-bar-chart-line"></i> İstatistikler
            </a>

            <form method="get" asp-action="GetPostsByCategoryId" class="flex-grow-1">
                <div class="input-group">
                    <select name="categoryId" class="form-select">
                        <option value="">Tüm Kategoriler</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Value">@category.Text</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-filter"></i> Filtrele
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(currentUserId))
            {
                <a asp-action="GetPostsByUserId" asp-route-userId="@currentUserId" class="btn btn-warning">
                    <i class="bi bi-person"></i> Yazar Yazıları
                </a>
            }
            else
            {
                <a asp-action="Login" asp-controller="Account" class="btn btn-warning">
                    <i class="bi bi-person"></i> Giriş Yap
                </a>
            }

            <a asp-action="SearchPosts" class="btn btn-secondary">
                <i class="bi bi-search"></i> Arama
            </a>
            <a asp-action="GetPopularPosts" asp-route-count="5" class="btn btn-primary">
                <i class="bi bi-fire"></i> Popüler
            </a>
        </div>

        @if (ViewBag.Posts != null)
        {
            <div class="dropdown mb-4">
                <button class="btn btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-link-45deg"></i> Slug Bağlantıları
                </button>
                <ul class="dropdown-menu">
                    @foreach (var post in ViewBag.Posts)
                    {
                        <li>
                            <a asp-action="GetPostBySlug" asp-route-slug="@post.Slug" class="dropdown-item">
                                @post.Title
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        <form id="bulkDeleteForm" asp-action="BulkDeletePosts" method="post">
            <button type="button" class="btn btn-danger mb-3" id="bulkDeleteButton">
                <i class="bi bi-trash"></i> Seçilenleri Sil
            </button>

            <div class="table-responsive">
                <table id="postTable" class="table table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll" /></th>
                            <th>Başlık</th>
                            <th>Video Yolu</th>
                            <th>Video URL</th>
                            <th>Kategori</th>
                            <th>Yazar</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="postIds" value="@post.Id" class="bulk-checkbox" />
                                </td>
                                <td>@post.Title</td>
                                <td>@post.VideoUrl</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(post.VideoUrl))
                                    {
                                        <a href="@post.VideoUrl" target="_blank" class="btn btn-link btn-sm">
                                            <i class="bi bi-play-btn"></i> İzle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>
                                <td>@post.CategoryName</td>
                                <td>@(post.FullName ?? "Bilinmiyor")</td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-gear"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a asp-action="Edit" asp-route-id="@post.Id" class="dropdown-item">
                                                    <i class="bi bi-pencil"></i> Düzenle
                                                </a>
                                            </li>
                                            <li>
                                                <form method="post" asp-action="Delete" asp-route-id="@post.Id" class="delete-form">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash"></i> Sil
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <a asp-action="GetPostDetails" asp-route-postId="@post.Id" class="dropdown-item">
                                                    <i class="bi bi-info-circle"></i> Detaylar
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable with responsive extension
            $('#postTable').DataTable({
                responsive: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/Turkish.json"
                },
                columnDefs: [
                    { orderable: false, targets: [0, 6] },
                    { searchable: false, targets: [0, 6] }
                ]
            });

            // Show success message
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Başarılı',
                        text: '@TempData["SuccessMessage"]',
                        confirmButtonColor: '#7367f0'
                    });
            </text>
        }

            // Individual delete confirmation
            document.querySelectorAll('.delete-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Bu yazıyı silmek istediğinize emin misiniz?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ea5455',
                        cancelButtonColor: '#7367f0',
                        confirmButtonText: 'Evet, sil!',
                        cancelButtonText: 'İptal',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });

            // Bulk delete confirmation
            document.getElementById('bulkDeleteButton').addEventListener('click', function(){
                const selectedCount = document.querySelectorAll('.bulk-checkbox:checked').length;
                if (selectedCount > 0) {
                    Swal.fire({
                        title: 'Emin misiniz?',
                        html: `<b>${selectedCount} yazı</b> silinecek. Bu işlem geri alınamaz!`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ea5455',
                        cancelButtonColor: '#7367f0',
                        confirmButtonText: 'Evet, sil!',
                        cancelButtonText: 'İptal',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('bulkDeleteForm').submit();
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'Uyarı!',
                        text: 'Lütfen silinecek yazıları seçiniz',
                        icon: 'warning',
                        confirmButtonColor: '#7367f0'
                    });
                }
            });

            // Select all checkboxes
            document.getElementById('selectAll').addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.bulk-checkbox');
                checkboxes.forEach(chk => chk.checked = this.checked);
            });
        });
    </script>
}