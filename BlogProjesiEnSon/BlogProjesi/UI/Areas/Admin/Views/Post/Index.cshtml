@model IEnumerable<Business.DTOs.PostDTOs.PostListDTO>
@{
    ViewBag.Title = "Yönetim Paneli - Yazı İşlemleri";
    Layout = "_AdminLayout";
}
@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section Scripts {
    <!-- jQuery (DataTables için gereklidir) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#postTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/Turkish.json"
                }
            });
        });

        // Başarı mesajını göster
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Başarılı',
                        text: '@TempData["SuccessMessage"]'
                    });
            </text>
        }

        // Bireysel silme onayı
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu yazıyı silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });

        // Toplu silme onayı
        document.getElementById('bulkDeleteButton').addEventListener('click', function(){
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Seçilen yazıları silmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('bulkDeleteForm').submit();
                }
            });
        });

        // Tümünü seç/deseç
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.bulk-checkbox');
            checkboxes.forEach(chk => chk.checked = this.checked);
        });
    </script>
}

<!-- Mobil uyum için -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">

<!-- Stil Ayarları -->
<style>
    .table td, .table th {
        word-wrap: break-word;
        white-space: normal;
    }

    .custom-table-container {
        max-height: 600px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .action-buttons .btn {
        margin-right: 5px;
        margin-bottom: 5px;
    }

    .dropdown-menu {
        min-width: 200px;
    }

    .slug-dropdown {
        margin-bottom: 10px;
    }
</style>

<div class="container mt-4">
    <!-- Kart yapısı ile sarıyoruz -->
    <div class="card">
        <!-- Kart Başlığı -->
        <div class="card-header">
            <h1 class="mb-4" style="margin-bottom:0!important;">Yazı İşlemleri</h1>
        </div>

        <!-- Kart Gövdesi -->
        <div class="card-body">

            <!-- Navigasyon Butonları -->
            <div class="mb-3 d-flex flex-wrap gap-2">
                <a href="@Url.Action("Create")" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Yeni Yazı
                </a>
                <a href="@Url.Action("GetPostStatistics")" class="btn btn-info">
                    <i class="bi bi-bar-chart-line"></i> İstatistikler
                </a>

                <!-- Kategori Filtreleme Formu -->
                <form method="get" action="@Url.Action("GetPostsByCategoryId", "Post")" class="flex-grow-1">
                    <div class="input-group">
                        <select id="categorySelect" name="categoryId" class="form-select">
                            <option value="">Tüm Kategoriler</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Value">@category.Text</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-filter"></i> Filtrele
                        </button>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(currentUserId))
                {
                    <a href="@Url.Action("GetPostsByUserId", new { userId = currentUserId })" class="btn btn-warning">
                        <i class="bi bi-person"></i> Yazar Yazıları
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-warning">
                        <i class="bi bi-person"></i> Giriş Yap
                    </a>
                }

                <a href="@Url.Action("SearchPosts")" class="btn btn-secondary">
                    <i class="bi bi-search"></i> Arama
                </a>
                <a href="@Url.Action("GetPopularPosts", new { count = 5 })" class="btn btn-primary">
                    <i class="bi bi-fire"></i> Popüler
                </a>
            </div>

            <!-- Slug Bağlantıları (Dropdown Menü) -->
            @if (ViewBag.Posts != null)
            {
                <div class="slug-dropdown">
                    <div class="dropdown">
                        <button class="btn btn-outline-dark dropdown-toggle" type="button" id="dropdownSlugButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-link-45deg"></i> Slug Bağlantıları
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownSlugButton">
                            @foreach (var post in ViewBag.Posts)
                            {
                                <li>
                                    <a href="@Url.Action("GetPostBySlug", new { slug = post.Slug })" class="dropdown-item">
                                        @post.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Yazı Listesi -->
            <form id="bulkDeleteForm" asp-action="BulkDeletePosts" method="post">
                <button type="button" class="btn btn-danger mb-3" id="bulkDeleteButton">
                    <i class="bi bi-trash"></i> Seçilenleri Sil
                </button>

                <div class="custom-table-container">
                    <table id="postTable" class="table table-bordered table-striped">
                        <thead class="table-light">
                            <tr>
                                <th><input type="checkbox" id="selectAll" /></th>
                                <th>Başlık</th>
                                <th>Video Yolu</th>
                                <th>Video URL</th>
                                <th>Kategori</th>
                                <th>Yazar</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="postIds" value="@post.Id" class="bulk-checkbox" />
                                    </td>
                                    <td>@post.Title</td>
                                    <td>@post.VideoUrl</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(post.VideoUrl))
                                        {
                                            <a href="@post.VideoUrl" target="_blank" class="btn btn-link btn-sm">
                                                <i class="bi bi-play-btn"></i> İzle
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Yok</span>
                                        }
                                    </td>
                                    <td>@post.CategoryName</td>
                                    <td>@(post.FullName ?? "Bilinmiyor")</td>
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-gear"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a href="@Url.Action("Edit", new { id = post.Id })" class="dropdown-item">
                                                        <i class="bi bi-pencil"></i> Düzenle
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="post" action="@Url.Action("Delete", new { id = post.Id })" class="delete-form">
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash"></i> Sil
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <a href="@Url.Action("GetPostDetails", new { postId = post.Id })" class="dropdown-item">
                                                        <i class="bi bi-info-circle"></i> Detaylar
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>

        </div> <!-- card-body -->
    </div> <!-- card -->
</div> <!-- container -->





