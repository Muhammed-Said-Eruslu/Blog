@model Business.DTOs.PostDTOs.PostStatisticsDTO
@{
    ViewBag.Title = "Yazı İstatistikleri";
    Layout = "_AdminLayout";
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

<!-- Ek stil: Listeleme kısmının kaydırılabilir olması için -->
<style>
    .scrollable-list {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

<div class="container my-5">
    <h2 class="mb-4 text-center">Yazı İstatistikleri</h2>

    <!-- Dropdown Menüleri: En Popüler Yazılar ve En Çok Yorum Alan Yazılar -->
    <div class="d-flex justify-content-center mb-4">
        <div class="dropdown me-3">
            <button class="btn btn-primary dropdown-toggle" type="button" id="popularPostsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                En Popüler Yazılar
            </button>
            <ul class="dropdown-menu" aria-labelledby="popularPostsDropdown">
                @foreach (var post in Model.PopularPosts)
                {
                    <li><a class="dropdown-item" href="#">@post.Title</a></li>
                }
            </ul>
        </div>
        <div class="dropdown">
            <button class="btn btn-success dropdown-toggle" type="button" id="mostCommentedPostsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                En Çok Yorum Alan Yazılar
            </button>
            <ul class="dropdown-menu" aria-labelledby="mostCommentedPostsDropdown">
                @foreach (var post in Model.MostCommentedPosts)
                {
                    <li><a class="dropdown-item" href="#">@post.Title</a></li>
                }
            </ul>
        </div>
    </div>

    <!-- Genel İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Toplam Yazı</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.TotalPosts</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Toplam Yorum</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.TotalComments</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">Toplam Etiket</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.TotalTags</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Kategorilere Göre Yazı Sayısı -->
    <div class="mb-4">
        <h3 class="mb-3">Kategorilere Göre Yazı Sayısı</h3>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Kategori</th>
                        <th>Yazı Sayısı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.PostCountByCategory)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.PostCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
