@model IDataResult<List<CategoryListDTO>>

@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "_AdminLayout";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title">@ViewData["Title"]</h4>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="mdi mdi-plus"></i> Yeni Kategori
            </a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-4">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="BulkDelete" method="post" id="bulkForm">
            <div class="bulk-actions mb-3">
                <button type="button" class="btn btn-danger" onclick="confirmBulkDelete()">
                    <i class="mdi mdi-delete"></i> Seçileni Sil
                </button>
            </div>

            <div class="table-responsive">
                <!-- DataTables kullanmak için tabloya id ekliyoruz -->
                <table class="table table-hover" id="categoryTable">
                    <thead>
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAll" />
                            </th>
                            <th>Kategori Adı</th>
                            <th>Slug</th>
                            <th>Açıklama</th>
                            <th>Post Sayısı</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="ids" value="@item.Id" class="bulk-checkbox" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Slug</td>
                                <td>@item.Description</td>
                                <td>@item.PostCount</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="mdi mdi-pencil"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="btn btn-sm btn-danger delete-btn" data-id="@item.Id">
                                        <i class="mdi mdi-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

<div class="mb-3">
    <a asp-action="Create" asp-controller="Category" class="btn btn-primary">
        Yeni Kategori Ekle
    </a>
</div>

@section Scripts {
    <!-- DataTables JS ve jQuery (Zaten Layout'ta olabilir) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <!-- SweetAlert (varsa projenin kendi referanslarını kullan) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Sayfa yüklendiğinde DataTables'ı başlat
        $(document).ready(function () {
            // DataTables başlatma
            $('#categoryTable').DataTable({
                // Türkçe dil ayarları (gerekirse ekleyebilirsin)
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json'
                }
            });
        });

        // Tümünü seç fonksiyonu
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.bulk-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Toplu silme onayı
        function confirmBulkDelete() {
            const selectedCount = document.querySelectorAll('.bulk-checkbox:checked').length;
            if (selectedCount > 0) {
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: `${selectedCount} kategori tamamen silinecek!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, sil!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('bulkForm').submit();
                    }
                });
            } else {
                Swal.fire({
                    title: 'Uyarı!',
                    text: 'Lütfen silinecek kategori seçiniz',
                    icon: 'warning'
                });
            }
        }

        // Tekil silme butonuna tıklandığında
        $(document).on('click', '.delete-btn', function () {
            var categoryId = $(this).data('id'); // Butondan kategori ID'sini alıyoruz

            // SweetAlert onay kutusu
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu kategori silinecek!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // AJAX isteği ile silme işlemini yapıyoruz
                    $.ajax({
                        url: '@Url.Action("DeleteConfirmed", "Category", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: categoryId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Silindi!', 'Kategori başarıyla silindi.', 'success');

                                // DataTables üzerinden ilgili satırı bulup kaldır
                                let table = $('#categoryTable').DataTable();
                                let row = $('a.delete-btn[data-id="' + categoryId + '"]').closest('tr');
                                table.row(row).remove().draw();
                            } else {
                                Swal.fire('Hata!', 'Kategori silinirken bir hata oluştu.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Hata!', 'Bir hata oluştu.', 'error');
                        }
                    });
                }
            });
        });
    </script>
}
