@model IDataResult<List<CategoryListDTO>>

@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" />
    <style>
        :root {
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --light-bg: #f8f8f8;
            --text-color: #5e5873;
        }

        body {
            background-color: #f5f5f9;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            background-color: #fff;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
        }

        .card-title {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 0;
        }

        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
            background-color: #fff;
        }

        .table {
            margin-bottom: 0;
            background-color: #fff;
        }

            .table th {
                border-top: none;
                font-weight: 600;
                color: #6e6b7b;
                background-color: var(--light-bg);
                padding: 1rem 1.5rem;
                vertical-align: middle;
            }

            .table td {
                padding: 1rem 1.5rem;
                vertical-align: middle;
                border-top: 1px solid rgba(34, 41, 47, 0.05);
                background-color: #fff;
            }

        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.5rem 1.25rem;
            box-shadow: none;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-primary:hover {
                background-color: #5d50e6;
                border-color: #5d50e6;
                transform: translateY(-2px);
            }

        .btn-danger {
            background-color: var(--danger-color);
            border-color: var(--danger-color);
        }

            .btn-danger:hover {
                background-color: #e42728;
                border-color: #e42728;
                transform: translateY(-2px);
            }

        .btn-warning {
            background-color: var(--warning-color);
            border-color: var(--warning-color);
        }

            .btn-warning:hover {
                background-color: #ff851a;
                border-color: #ff851a;
                transform: translateY(-2px);
            }

        .btn-sm {
            padding: 0.375rem 0.75rem;
        }

        .btn i {
            margin-right: 0.25rem;
        }

        .alert {
            border-radius: 6px;
            border: none;
        }

        .bulk-actions {
            background-color: var(--light-bg);
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

            .bulk-actions .form-check {
                margin-bottom: 0;
            }

        .selected-count {
            margin-left: auto;
            color: #6e6b7b;
            font-size: 0.875rem;
        }

        /* Checkbox styling */
        [type="checkbox"]:not(:checked),
        [type="checkbox"]:checked {
            position: absolute;
            left: -9999px;
        }

            [type="checkbox"]:not(:checked) + label,
            [type="checkbox"]:checked + label {
                position: relative;
                padding-left: 2rem;
                cursor: pointer;
                margin-bottom: 0;
            }

                [type="checkbox"]:not(:checked) + label:before,
                [type="checkbox"]:checked + label:before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    width: 1.25rem;
                    height: 1.25rem;
                    border: 2px solid #ddd;
                    background: #fff;
                    border-radius: 4px;
                    transition: var(--transition);
                }

                [type="checkbox"]:not(:checked) + label:after,
                [type="checkbox"]:checked + label:after {
                    content: '✓';
                    position: absolute;
                    top: 0.1rem;
                    left: 0.25rem;
                    font-size: 1rem;
                    color: var(--primary-color);
                    transition: var(--transition);
                    opacity: 0;
                    transform: scale(0);
                }

                [type="checkbox"]:checked + label:after {
                    opacity: 1;
                    transform: scale(1);
                }

                [type="checkbox"]:checked + label:before {
                    border-color: var(--primary-color);
                }

        /* Badge styling */
        .badge {
            font-weight: 500;
            padding: 0.35em 0.65em;
        }

        .badge-light-primary {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
        }

        .badge-light-secondary {
            background-color: rgba(130, 134, 139, 0.12);
            color: #82868b;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-header

        {
            flex-direction: column;
            align-items: flex-start;
        }

        .card-header > div {
            margin-top: 1rem;
            width: 100%;
        }

        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        .table td, .table th {
            padding: 0.75rem;
        }

        .table-responsive {
            border: 1px solid #eee;
        }

        .bulk-actions {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .selected-count {
            margin-left: 0;
            margin-top: 0.5rem;
        }

        }
    </style>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="card-title">
            <i class="mdi mdi-tag-multiple me-2"></i>@ViewData["Title"]
        </h4>
        <div class="d-flex align-items-center">
            <a asp-action="Create" class="btn btn-primary">
                <i class="mdi mdi-plus"></i> Yeni Kategori
            </a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                <i class="mdi mdi-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4">
                <i class="mdi mdi-alert-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="BulkDelete" method="post" id="bulkForm">
            <div class="bulk-actions">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="selectAll">
                    <label class="form-check-label" for="selectAll">Tümünü Seç</label>
                </div>
                <button type="button" class="btn btn-danger" onclick="confirmBulkDelete()">
                    <i class="mdi mdi-delete"></i> Seçileni Sil
                </button>
                <span class="selected-count">0 öğe seçildi</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover" id="categoryTable" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Kategori Adı</th>
                            <th>Slug</th>
                            <th>Açıklama</th>
                            <th>Post Sayısı</th>
                            <th style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>
                                    <div class="form-check">
                                        <input type="checkbox" name="ids" value="@item.Id" class="form-check-input bulk-checkbox">
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-light-primary rounded-pill me-2" style="min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                            <i class="mdi mdi-tag fs-5"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold">@item.Name</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light-secondary text-dark">@item.Slug</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@item.Description">
                                            @item.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Açıklama yok</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light-primary">@item.PostCount</span>
                                </td>
                                <td>
                                    <div class="d-flex">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2" title="Düzenle">
                                            <i class="mdi mdi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2" title="Detaylar">
                                            <i class="mdi mdi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="@item.Id" title="Sil">
                                            <i class="mdi mdi-delete"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable with enhanced features
            const table = $('#categoryTable').DataTable({
                responsive: true,
                dom: '<"top"<"row"<"col-md-6"B><"col-md-6"f>>>rt<"bottom"<"row"<"col-md-6"i><"col-md-6"p>>><"clear">',
                buttons: [
                    {
                        extend: 'copy',
                        className: 'btn btn-sm btn-outline-secondary',
                        text: '<i class="mdi mdi-content-copy"></i> Kopyala'
                    },
                    {
                        extend: 'excel',
                        className: 'btn btn-sm btn-outline-success',
                        text: '<i class="mdi mdi-file-excel"></i> Excel'
                    },
                    {
                        extend: 'print',
                        className: 'btn btn-sm btn-outline-info',
                        text: '<i class="mdi mdi-printer"></i> Yazdır'
                    }
                ],
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json'
                },
                columnDefs: [
                    { orderable: false, targets: [0, 5] },
                    { searchable: false, targets: [0, 4, 5] }
                ],
                initComplete: function() {
                    $('.dataTables_filter input').addClass('form-control');
                    $('.dataTables_length select').addClass('form-select');
                }
            });

            // Select all checkbox functionality
            $('#selectAll').on('change', function() {
                const isChecked = $(this).prop('checked');
                $('.bulk-checkbox').prop('checked', isChecked).trigger('change');
            });

            // Individual checkbox change
            $(document).on('change', '.bulk-checkbox', function() {
                const totalChecked = $('.bulk-checkbox:checked').length;
                $('.selected-count').text(`${totalChecked} öğe seçildi`);

                // Update select all checkbox state
                const totalCheckboxes = $('.bulk-checkbox').length;
                $('#selectAll').prop('checked', totalChecked === totalCheckboxes);
            });
        });

        // Bulk delete confirmation
        function confirmBulkDelete() {
            const selectedCount = $('.bulk-checkbox:checked').length;
            if (selectedCount > 0) {
                Swal.fire({
                    title: 'Emin misiniz?',
                    html: `<b>${selectedCount} kategori</b> tamamen silinecek. Bu işlem geri alınamaz!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal',
                    confirmButtonColor: '#ea5455',
                    cancelButtonColor: '#7367f0',
                    reverseButtons: true,
                    customClass: {
                        confirmButton: 'btn btn-danger me-2',
                        cancelButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#bulkForm').submit();
                    }
                });
            } else {
                Swal.fire({
                    title: 'Uyarı!',
                    text: 'Lütfen silinecek kategori seçiniz',
                    icon: 'warning',
                    confirmButtonColor: '#7367f0',
                    customClass: {
                        confirmButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                });
            }
        }

        // Single delete button handler
        $(document).on('click', '.delete-btn', function () {
            const categoryId = $(this).data('id');
            const categoryName = $(this).closest('tr').find('td:eq(1)').text().trim();

            Swal.fire({
                title: 'Kategori Silinecek!',
                html: `<b>"${categoryName}"</b> adlı kategori silinecek. Bu işlem geri alınamaz!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Evet, sil!',
                cancelButtonText: 'İptal',
                confirmButtonColor: '#ea5455',
                cancelButtonColor: '#7367f0',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'btn btn-danger me-2',
                    cancelButton: 'btn btn-primary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteConfirmed", "Category", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: categoryId },
                        beforeSend: function() {
                            Swal.showLoading();
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Silindi!',
                                    text: 'Kategori başarıyla silindi.',
                                    icon: 'success',
                                    confirmButtonColor: '#7367f0',
                                    customClass: {
                                        confirmButton: 'btn btn-primary'
                                    },
                                    buttonsStyling: false
                                });

                                // Refresh the table
                                $('#categoryTable').DataTable().ajax.reload(null, false);
                            } else {
                                Swal.fire({
                                    title: 'Hata!',
                                    text: response.message || 'Kategori silinirken bir hata oluştu.',
                                    icon: 'error',
                                    confirmButtonColor: '#7367f0',
                                    customClass: {
                                        confirmButton: 'btn btn-primary'
                                    },
                                    buttonsStyling: false
                                });
                            }
                        },
                        error: function (xhr) {
                            Swal.fire({
                                title: 'Hata!',
                                text: xhr.responseJSON?.message || 'Bir hata oluştu.',
                                icon: 'error',
                                confirmButtonColor: '#7367f0',
                                customClass: {
                                    confirmButton: 'btn btn-primary'
                                },
                                buttonsStyling: false
                            });
                        }
                    });
                }
            });
        });
    </script>
}