@model CategoryDTO
@{
    ViewData["Title"] = "Kategori Detayları";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root {
            --primary-color: #7367f0;
            --danger-color: #ea5455;
            --warning-color: #ff9f43;
            --success-color: #28c76f;
            --border-color: #d8d6de;
            --card-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: #f5f5f9;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-weight: 600;
            color: #5e5873;
            margin-bottom: 0;
            display: flex;
            align-items: center;
        }

        .card-title i {
            margin-right: 10px;
            font-size: 1.5rem;
        }

        .card-body {
            padding: 2rem;
        }

        .detail-list {
            margin-bottom: 2rem;
        }

        .detail-list dt {
            font-weight: 600;
            color: #5e5873;
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
        }

        .detail-list dd {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(34, 41, 47, 0.05);
            margin-left: 0;
        }

        .detail-list dt.col-sm-2 {
            width: 200px;
        }

        .detail-list dd.col-sm-10 {
            width: calc(100% - 200px);
        }

        .btn {
            font-weight: 500;
            border-radius: 6px;
            transition: var(--transition);
            padding: 0.75rem 1.5rem;
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
        }

        .btn i {
            margin-right: 0.5rem;
            font-size: 1.1rem;
        }

        .btn-warning {
            background-color: var(--warning-color);
            color: white;
        }

        .btn-warning:hover {
            background-color: #ff851a;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background-color: #82868b;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #6c757d;
            transform: translateY(-2px);
        }

        .btn-danger {
            background-color: var(--danger-color);
            color: white;
        }

        .btn-danger:hover {
            background-color: #e42728;
            transform: translateY(-2px);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .badge {
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
        }

        .badge-light-primary {
            background-color: rgba(115, 103, 240, 0.12);
            color: var(--primary-color);
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .card-body {
                padding: 1.5rem;
            }

            .detail-list dt.col-sm-2,
            .detail-list dd.col-sm-10 {
                width: 100%;
            }

            .detail-list dt {
                padding-top: 1rem;
                border-bottom: none;
            }

            .detail-list dd {
                padding-top: 0.25rem;
                padding-bottom: 1rem;
                margin-bottom: 0.5rem;
            }

            .action-buttons {
                flex-direction: column;
                gap: 0.75rem;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">
            <i class="mdi mdi-tag-text"></i>@ViewData["Title"]
        </h4>
        <div class="badge badge-light-primary">
            <i class="mdi mdi-identifier me-1"></i>ID: @Model.Id
        </div>
    </div>
    <div class="card-body">
        <dl class="row detail-list">
            <dt class="col-sm-2">Kategori Adı:</dt>
            <dd class="col-sm-10">
                <div class="d-flex align-items-center">
                    <div class="badge badge-light-primary rounded-pill me-3" style="min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="mdi mdi-tag fs-5"></i>
                    </div>
                    <span class="fw-semibold">@Model.Name</span>
                </div>
            </dd>

            <dt class="col-sm-2">SEO URL:</dt>
            <dd class="col-sm-10">
                <span class="badge bg-light-secondary">/@Model.Slug</span>
            </dd>

            <dt class="col-sm-2">Açıklama:</dt>
            <dd class="col-sm-10">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="white-space: pre-line;">@Model.Description</p>
                }
                else
                {
                    <span class="text-muted">Açıklama girilmemiş</span>
                }
            </dd>

            <dt class="col-sm-2">Oluşturulma Tarihi:</dt>
            <dd class="col-sm-10">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-2">Güncellenme Tarihi:</dt>
            <dd class="col-sm-10">
                @(Model.ModifiedDate.HasValue ? Model.ModifiedDate.Value.ToString("dd.MM.yyyy HH:mm") : "Güncellenmemiş")
            </dd>

            <dt class="col-sm-2">Toplam Yazı:</dt>
            <dd class="col-sm-10">
                <span class="badge bg-light-primary">@Model.PostCount</span>
            </dd>
        </dl>

        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="mdi mdi-pencil"></i> Düzenle
            </a>
            <button type="button" class="btn btn-danger" id="deleteButton">
                <i class="mdi mdi-delete"></i> Sil
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="mdi mdi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // Delete button handler
            $('#deleteButton').on('click', function() {
                Swal.fire({
                    title: 'Emin misiniz?',
                    html: `<b>@Model.Name</b> adlı kategori tamamen silinecek. Bu işlem geri alınamaz!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal',
                    confirmButtonColor: '#ea5455',
                    cancelButtonColor: '#7367f0',
                    reverseButtons: true,
                    customClass: {
                        confirmButton: 'btn btn-danger me-2',
                        cancelButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Delete", "Category", new { id = Model.Id })';
                    }
                });
            });
        });
    </script>
}