@model CategoryDTO

@{
    ViewData["Title"] = "Kategori Detayları";
    Layout = "_AdminLayout";
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">@ViewData["Title"]</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">Adı:</dt>
            <dd class="col-sm-10">@Model.Name</dd>
            <dt class="col-sm-2">Açıklama:</dt>
            <dd class="col-sm-10">@Model.Description</dd>
            <dt class="col-sm-2">Oluşturulma Tarihi:</dt>
            <dd class="col-sm-10">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
            <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        </div>
    </div>
</div>