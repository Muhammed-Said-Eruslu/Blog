@using Business.DTOs.CommentsDTOs
@using UI.Areas.Admin.Truncate
@model List<CommentListDTO>

@{
    ViewData["Title"] = "Kullanıcı Yorumları";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h2>@ViewData["Title"]</h2>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info">
            @ViewBag.Message
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Yorum ID</th>
                            <th>İçerik</th>
                            <th>Oluşturulma Tarihi</th>
                            <th>Bağlı Olduğu Yazı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model)
                        {
                            <tr>
                                <td>@comment.Id</td>
                                <td>@comment.Content.Truncate(50)</td>
                                <td>@comment.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>@comment.PostId</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@comment.Id" class="btn btn-info btn-sm">
                                        <i class="fas fa-info-circle"></i> Detaylar
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Düzenle
                                    </a>
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@comment.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?')">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>