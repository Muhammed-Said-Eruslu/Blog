@using Business.DTOs.CommentsDTOs
@using UI.Areas.Admin.Truncate
@model List<CommentListDTO>
@{
    ViewData["Title"] = "Yazı Yorumları";
    Layout = "_AdminLayout";
}

<style>
    .comment-table {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .comment-table thead th {
            background-color: #4e73df;
            color: white;
            font-weight: 600;
            border: none;
        }

        .comment-table tbody tr {
            transition: all 0.2s ease;
        }

            .comment-table tbody tr:hover {
                background-color: #f8f9fc;
                transform: translateX(2px);
            }

    .comment-content-cell {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-buttons .btn {
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
        margin-right: 0.3rem;
    }

    .badge-post {
        background-color: #e74a3b;
        color: white;
        font-size: 0.7rem;
    }

    .comment-date {
        white-space: nowrap;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
            <span class="badge badge-primary">Toplam @Model.Count Yorum</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table comment-table table-hover">
                    <thead>
                        <tr>
                            <th>İçerik</th>
                            <th>Yazar</th>
                            <th>Yazı</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="comment-content-cell" title="@item.Content">
                                    @item.Content.Truncate(50)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-2"
                                             style="width: 30px; height: 30px; font-size: 0.8rem;">
                                            @item.AuthorName.Substring(0, 1).ToUpper()
                                        </div>
                                        @item.AuthorName
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-post" title="Yazı ID: @item.PostId">
                                        @item.PostId
                                    </span>
                                </td>
                                <td class="comment-date">
                                    @item.CreatedDate.ToString("dd MMM yyyy HH:mm")
                                </td>
                                <td class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm" title="Detaylar">
                                        Detay
                                    </a>
                                    <button onclick="confirmDelete('@item.Id')"
                                            class="btn btn-danger btn-sm" title="Sil">
                                        Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(commentId) {
            if (confirm('Bu yorumu silmek istediğinize emin misiniz?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "Comment")/' + commentId,
                    type: 'POST',
                    success: function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Silme işlemi başarısız: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('Silme işlemi sırasında bir hata oluştu.');
                    }
                });
            }
        }
    </script>
}