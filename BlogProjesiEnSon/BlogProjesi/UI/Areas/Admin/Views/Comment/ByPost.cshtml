@using Business.DTOs.CommentsDTOs
@using UI.Areas.Admin.Truncate
@model List<CommentListDTO>
@{
    ViewData["Title"] = "Yazı Yorumları";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>İçerik</th>
                            <th>Yazar</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Content.Truncate(50)</td> <!-- İçeriği 50 karakterle kısalt -->
                                <td>@item.AuthorName</td> <!-- Yazar adı -->
                                <td>@item.CreatedDate.ToString("dd MMM yyyy")</td> <!-- Tarih formatı -->
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a> <!-- Detay sayfasına yönlendiren buton -->
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
