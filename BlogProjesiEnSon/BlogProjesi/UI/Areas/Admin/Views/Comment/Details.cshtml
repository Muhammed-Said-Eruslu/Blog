@using Business.DTOs.CommentsDTOs
@model CommentDTO
@{
    ViewData["Title"] = "Yorum Detayları";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">İçerik:</dt>
                <dd class="col-sm-10">@Model.Content</dd>

                <dt class="col-sm-2">Yazar:</dt>
                <dd class="col-sm-10">@Model.AuthorName (@Model.AuthorEmail)</dd>

                <dt class="col-sm-2">Yazı ID:</dt>
                <dd class="col-sm-10">@Model.PostId</dd>

                <dt class="col-sm-2">Oluşturulma:</dt>
                <dd class="col-sm-10">@Model.CreatedAt.ToString("f")</dd>

                <dt class="col-sm-2">Güncelleme:</dt>
                <dd class="col-sm-10">
                    @if (Model.UpdatedDate.HasValue)
                    {
                        @Model.UpdatedDate.Value.ToString("f")
                    }
                    else
                    {
                        <span>Henüz güncellenmedi</span>
                    }
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Düzenle</a>
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </div>
    </div>
</div>
