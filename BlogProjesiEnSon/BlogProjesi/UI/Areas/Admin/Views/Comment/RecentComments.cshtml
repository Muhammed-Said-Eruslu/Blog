@using Business.DTOs.CommentsDTOs
@using Humanizer
@using UI.Areas.Admin.Truncate
@model List<CommentListDTO>
@{
    ViewData["Title"] = "Son Yorumlar";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var comment in Model)
                {
                    // Yorumun oluşturulma tarihini UTC'den Türkiye saatine dönüştürme
                    var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time");
                    var localTime = TimeZoneInfo.ConvertTimeFromUtc(comment.CreatedDate, timeZone);

                    // Zamanı "X saat önce" formatında almak
                    var timeAgo = localTime.Humanize(true);

                    <a asp-action="Details" asp-route-id="@comment.Id"
                       class="list-group-item list-group-item-action flex-column align-items-start border-0 rounded shadow-sm mb-3">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <h6 class="mb-1 font-weight-bold">@comment.AuthorName</h6>
                            <small class="text-muted">@timeAgo</small> <!-- "X saat önce" formatı -->
                        </div>
                        <p class="mb-1 text-truncate" style="max-width: 100%;">@UI.Areas.Admin.Truncate.StringExtensions.Truncate(comment.Content, 100)</p>
                        <small class="text-muted">Yazı ID: @comment.PostId</small>
                    </a>

                    <!-- Yorumun oluşturulma tarih ve saatini göstermek -->
                    <table>
                        <tr>
                            <td>@localTime.ToString("dd MMM yyyy HH:mm")</td> <!-- Yerel tarihi ve saati gösteriyoruz -->
                        </tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
