@using Business.DTOs.CommentsDTOs
@using Humanizer
@using UI.Areas.Admin.Truncate
@model List<CommentListDTO>
@{
    ViewData["Title"] = "Son Yorumlar";
    Layout = "_AdminLayout";
}

<style>
    .comment-card {
        transition: all 0.3s ease;
        border-left: 4px solid #4e73df;
        border-radius: 0.35rem;
        margin-bottom: 1rem;
    }

        .comment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border-left-color: #2e59d9;
        }

    .comment-content {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .comment-author {
        font-weight: 600;
        color: #2e59d9;
    }

    .comment-time {
        background: #f8f9fc;
        padding: 0.25rem 0.5rem;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .comment-meta {
        font-size: 0.85rem;
        color: #858796;
    }

    .text-action-btn {
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
        margin-left: 0.5rem;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
            <span class="badge badge-primary">@Model.Count Yorum</span>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @foreach (var comment in Model)
                {
                    // Yorumun oluşturulma tarihini UTC'den Türkiye saatine dönüştürme
                    var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time");
                    var localTime = TimeZoneInfo.ConvertTimeFromUtc(comment.CreatedDate, timeZone);
                    var timeAgo = localTime.Humanize(true);

                    <div class="comment-card list-group-item list-group-item-action flex-column align-items-start p-4">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px; font-size: 1rem;">
                                    @comment.AuthorName.Substring(0, 1).ToUpper()
                                </div>
                                <div class="ml-3">
                                    <h6 class="comment-author mb-0">@comment.AuthorName</h6>
                                </div>
                            </div>
                            <span class="comment-time" title="@localTime.ToString("dd MMMM yyyy HH:mm")">
                                @timeAgo
                            </span>
                        </div>

                        <div class="pl-5">
                            <p class="comment-content my-3">@comment.Content</p>

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="comment-meta">
                                    <span class="mr-2">Yazı ID: @comment.PostId</span>
                                    <span>@localTime.ToString("dd MMM yyyy HH:mm")</span>
                                </div>

                                <div>
                                    <a asp-action="Details" asp-route-id="@comment.Id"
                                       class="btn btn-sm btn-primary text-action-btn">
                                        Detaylar
                                    </a>
                                    <a href="#" class="btn btn-sm btn-danger text-action-btn"
                                       onclick="confirmDelete('@comment.Id')">
                                        Sil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(commentId) {
            if (confirm('Bu yorumu silmek istediğinize emin misiniz?')) {
                // Silme işlemi için AJAX çağrısı
                $.ajax({
                    url: '@Url.Action("Delete", "Comment")/' + commentId,
                    type: 'POST',
                    success: function(result) {
                        if (result.success) {
                            location.reload(); // Sayfayı yenile
                        } else {
                            alert('Silme işlemi başarısız: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('Silme işlemi sırasında bir hata oluştu.');
                    }
                });
            }
        }
    </script>
}