@model UI.Areas.Admin.Models.VMs.DashboardVM.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Dashboard";
}

<div class="content-wrapper">
    <!-- Başlık -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-white">Yönetim Paneli</h1>
            <p class="text-muted">Genel istatistikler ve hızlı erişim kısayolları</p>
        </div>
    </div>

    <!-- İstatistik Kartları (Toplam Yazı, Kategori, Yorum, Kullanıcı) -->
    <div class="row mb-4">
        <!-- Toplam Yazı -->
        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="mb-2">Toplam Yazı</h4>
                    <h2>@Model.TotalPosts</h2>
                    <p class="mt-2">Son 24 saatte @Model.NewPostsLast24Hours yeni yazı eklendi.</p>
                    <i class="mdi mdi-file-document-box mdi-48px float-right"></i>
                </div>
            </div>
        </div>
        <!-- Toplam Kategori -->
        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h4 class="mb-2">Toplam Kategori</h4>
                    <h2>@Model.TotalCategories</h2>
                    <p class="mt-2">Kategori sayısı güncel.</p>
                    <i class="mdi mdi-tag-multiple mdi-48px float-right"></i>
                </div>
            </div>
        </div>
        <!-- Toplam Yorum -->
        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h4 class="mb-2">Toplam Yorum</h4>
                    <h2>@Model.TotalComments</h2>
                    <p class="mt-2">Son 24 saatte @Model.NewCommentsLast24Hours yeni yorum.</p>
                    <i class="mdi mdi-comment-multiple-outline mdi-48px float-right"></i>
                </div>
            </div>
        </div>
        <!-- Toplam Kullanıcı -->
        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h4 class="mb-2">Toplam Kullanıcı</h4>
                    <h2>@Model.TotalUsers</h2>
                    <p class="mt-2">Identity üzerinden çekildi.</p>
                    <i class="mdi mdi-account-multiple mdi-48px float-right"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Örnek "Gelir" Kartı -->
    <div class="row mb-4">
        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-9">
                            <div class="d-flex align-items-center align-self-start">
                                <h3 class="mb-0">$12.34</h3>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="icon icon-box-success">
                                <span class="mdi mdi-arrow-top-right icon-item"></span>
                            </div>
                        </div>
                    </div>
                    <h6 class="text-muted font-weight-normal">Toplam Gelir</h6>
                </div>
            </div>
        </div>
    </div>

    <!-- Aylık Yazı Grafiği (Chart.js) + Hızlı Erişim -->
    <div class="row mb-4">
        <!-- Grafik Alanı -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Aylık Yazı İstatistikleri</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="monthlyPostsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hızlı Erişim -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Hızlı Erişim</h5>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("Create", "Post")" class="btn btn-primary btn-block mb-2">
                        <i class="mdi mdi-plus"></i> Yeni Yazı Ekle
                    </a>
                    <a href="@Url.Action("Index", "Comment")" class="btn btn-info btn-block mb-2">
                        <i class="mdi mdi-comment"></i> Yorum Yönetimi
                    </a>
                    <a href="@Url.Action("Index", "Category")" class="btn btn-success btn-block mb-2">
                        <i class="mdi mdi-tag"></i> Kategori Yönetimi
                    </a>
                    <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="btn btn-warning btn-block">
                        <i class="mdi mdi-account"></i> Kullanıcı Yönetimi
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- En Popüler ve Son Yazılar -->
    <div class="row mb-4">
        <div class="col-md-6 mb-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">En Popüler Yazılar</h5>
                </div>
                <div class="card-body">
                    @if (Model.PopularPosts != null && Model.PopularPosts.Any())
                    {
                        <ul class="list-group">
                            @foreach (var postTitle in Model.PopularPosts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @postTitle
                                    <span class="badge badge-primary badge-pill">1000+ Görüntüleme</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Popüler yazı bulunamadı.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-2">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Son Eklenen Yazılar</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentPosts != null && Model.RecentPosts.Any())
                    {
                        <ul class="list-group">
                            @foreach (var postTitle in Model.RecentPosts)
                            {
                                <li class="list-group-item">
                                    @postTitle
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Henüz yeni bir yazı eklenmedi.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Kütüphanesi -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Aylık yazı verisi (int[] dizisi)
    var monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyPostCounts));

    // Ocak - Aralık etiketler
    var monthLabels = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
                       "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];

    var ctx = document.getElementById('monthlyPostsChart').getContext('2d');
    var monthlyPostsChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Aylık Yazı Sayısı',
                data: monthlyData,
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

<style>
    /* Kart ve Layout Stilleri */
    .card {
        border: none;
        transition: transform 0.3s;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 1rem; /* Kartlar arasında dikey boşluk */
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .chart-container {
        position: relative;
        height: 400px;
        width: 100%;
    }

    .badge.badge-primary {
        background: #007bff;
    }

        .badge.badge-primary.badge-pill {
            border-radius: 50px;
        }

    .list-group-item:hover {
        background-color: #f0f0f0;
    }

    /* **Responsive Kartlar** - Kolonların ekran boyutlarına göre değişmesi */
    @@media (max-width: 1200px) {
        .col-xl-3

    {
        width: 50%; /* Daha büyük ekranlarda kartlar %50 genişlikte */
    }

    }

    @@media (max-width: 992px) {
        .col-xl-3

    {
        width: 50%; /* Tabletlerde de 2 kart aynı satırda */
    }

    .col-sm-6 {
        width: 100%; /* Küçük ekranlarda her kart tek satırda */
    }

    .chart-container {
        height: 300px; /* Grafik boyutunu küçült */
    }

    }

    @@media (max-width: 768px) {
        .col-xl-3, .col-sm-6

    {
        width: 100%; /* Mobilde her kart full genişlikte olacak */
    }

    .chart-container {
        height: 250px; /* Grafik boyutunu mobilde küçült */
    }

    /* Hızlı erişim butonları daha küçük ekranlarda */
    .btn-block {
        font-size: 14px;
        padding: 10px;
    }

    }

    /* 576px ve daha küçük ekranlar için tüm düzeni optimize et */
    @@media (max-width: 576px) {
        .card-header h5

    {
        font-size: 16px; /* Başlık font boyutunu küçült */
    }

    .btn-block {
        font-size: 12px; /* Butonları küçük ekranlara uygun hale getir */
    }

    /* Grafik boyutunu daha da küçült */
    .chart-container {
        height: 200px;
    }

    }
</style>

