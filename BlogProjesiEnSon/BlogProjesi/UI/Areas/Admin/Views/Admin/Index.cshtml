@model UI.Areas.Admin.Models.VMs.DashboardVM.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Dashboard";
}

<div class="content-wrapper">
    <!-- Page Header -->
    <div class="page-header">
        <h3 class="page-title">
            <span class="page-title-icon bg-gradient-primary text-white me-2">
                <i class="mdi mdi-speedometer"></i>
            </span>
            Yönetim Paneli
        </h3>
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">
                    <span></span>Genel İstatistikler
                </li>
            </ul>
        </nav>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row">
        <!-- Toplam Yazı -->
        <div class="col-md-6 col-lg-3 grid-margin stretch-card">
            <div class="card card-statistics">
                <div class="card-body">
                    <div class="d-flex flex-md-column flex-xl-row flex-wrap justify-content-between align-items-md-center justify-content-xl-between">
                        <div class="float-left">
                            <i class="mdi mdi-file-document-box text-primary icon-lg"></i>
                        </div>
                        <div class="float-right">
                            <p class="mb-0 text-right">Toplam Yazı</p>
                            <div class="fluid-container">
                                <h3 class="font-weight-medium text-right mb-0">@Model.TotalPosts</h3>
                            </div>
                            <p class="text-muted mt-2 mb-0 text-right small">
                                <i class="mdi mdi-clock-outline mr-1"></i>
                                Son 24 saat: @Model.NewPostsLast24Hours
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toplam Kategori -->
        <div class="col-md-6 col-lg-3 grid-margin stretch-card">
            <div class="card card-statistics">
                <div class="card-body">
                    <div class="d-flex flex-md-column flex-xl-row flex-wrap justify-content-between align-items-md-center justify-content-xl-between">
                        <div class="float-left">
                            <i class="mdi mdi-tag-multiple text-success icon-lg"></i>
                        </div>
                        <div class="float-right">
                            <p class="mb-0 text-right">Toplam Kategori</p>
                            <div class="fluid-container">
                                <h3 class="font-weight-medium text-right mb-0">@Model.TotalCategories</h3>
                            </div>
                            <p class="text-muted mt-2 mb-0 text-right small">
                                <i class="mdi mdi-reload mr-1"></i>
                                Güncel Durum
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toplam Yorum -->
        <div class="col-md-6 col-lg-3 grid-margin stretch-card">
            <div class="card card-statistics">
                <div class="card-body">
                    <div class="d-flex flex-md-column flex-xl-row flex-wrap justify-content-between align-items-md-center justify-content-xl-between">
                        <div class="float-left">
                            <i class="mdi mdi-comment-multiple-outline text-info icon-lg"></i>
                        </div>
                        <div class="float-right">
                            <p class="mb-0 text-right">Toplam Yorum</p>
                            <div class="fluid-container">
                                <h3 class="font-weight-medium text-right mb-0">@Model.TotalComments</h3>
                            </div>
                            <p class="text-muted mt-2 mb-0 text-right small">
                                <i class="mdi mdi-clock-outline mr-1"></i>
                                Son 24 saat: @Model.NewCommentsLast24Hours
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toplam Kullanıcı -->
        <div class="col-md-6 col-lg-3 grid-margin stretch-card">
            <div class="card card-statistics">
                <div class="card-body">
                    <div class="d-flex flex-md-column flex-xl-row flex-wrap justify-content-between align-items-md-center justify-content-xl-between">
                        <div class="float-left">
                            <i class="mdi mdi-account-multiple text-warning icon-lg"></i>
                        </div>
                        <div class="float-right">
                            <p class="mb-0 text-right">Toplam Kullanıcı</p>
                            <div class="fluid-container">
                                <h3 class="font-weight-medium text-right mb-0">@Model.TotalUsers</h3>
                            </div>
                            <p class="text-muted mt-2 mb-0 text-right small">
                                <i class="mdi mdi-account-key mr-1"></i>
                                Identity Yönetimi
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafik ve Hızlı Erişim -->
    <div class="row">
        <!-- Grafik Alanı -->
        <div class="col-lg-8 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Aylık Yazı İstatistikleri</h4>
                    <div class="chart-container">
                        <canvas id="monthlyPostsChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hızlı Erişim -->
        <div class="col-lg-4 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Hızlı Erişim</h4>
                    <div class="quick-access-buttons">
                        <a href="@Url.Action("Create", "Post")" class="btn btn-block btn-gradient-primary btn-lg mb-3">
                            <i class="mdi mdi-plus-circle-outline mr-2"></i> Yeni Yazı Ekle
                        </a>
                        <a href="@Url.Action("Index", "Comment")" class="btn btn-block btn-gradient-info btn-lg mb-3">
                            <i class="mdi mdi-comment-processing-outline mr-2"></i> Yorum Yönetimi
                        </a>
                        <a href="@Url.Action("Index", "Category")" class="btn btn-block btn-gradient-success btn-lg mb-3">
                            <i class="mdi mdi-tag-outline mr-2"></i> Kategori Yönetimi
                        </a>
                        <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="btn btn-block btn-gradient-warning btn-lg">
                            <i class="mdi mdi-account-settings-variant mr-2"></i> Kullanıcı Yönetimi
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Popüler ve Son Yazılar -->
    <div class="row">
        <!-- En Popüler Yazılar -->
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">En Popüler Yazılar</h4>
                    <div class="table-responsive">
                        @if (Model.PopularPosts != null && Model.PopularPosts.Any())
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Yazı Başlığı</th>
                                        <th>Görüntülenme</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var postTitle in Model.PopularPosts)
                                    {
                                        <tr>
                                            <td>@postTitle</td>
                                            <td><span class="badge badge-primary badge-pill">1000+</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-info">Popüler yazı bulunamadı.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Son Eklenen Yazılar -->
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Son Eklenen Yazılar</h4>
                    <div class="list-wrapper">
                        @if (Model.RecentPosts != null && Model.RecentPosts.Any())
                        {
                            <ul class="d-flex flex-column-reverse todo-list">
                                @foreach (var postTitle in Model.RecentPosts)
                                {
                                    <li class="completed">
                                        <div class="form-check">
                                            <label class="form-check-label">
                                                @postTitle
                                            </label>
                                        </div>
                                        <i class="remove mdi mdi-close-circle-outline"></i>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="alert alert-info">Henüz yeni bir yazı eklenmedi.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Aylık yazı verisi
    var monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyPostCounts));

    // Ay etiketleri
    var monthLabels = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
                      "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];

    // Grafik oluşturma
    var ctx = document.getElementById('monthlyPostsChart').getContext('2d');
    var monthlyPostsChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Yazı Sayısı',
                data: monthlyData,
                backgroundColor: 'rgba(75, 73, 172, 0.2)',
                borderColor: 'rgba(75, 73, 172, 1)',
                borderWidth: 2,
                tension: 0.3,
                fill: true,
                pointBackgroundColor: '#fff',
                pointBorderColor: 'rgba(75, 73, 172, 1)',
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleFont: {
                        size: 14,
                        weight: 'bold'
                    },
                    bodyFont: {
                        size: 12
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        drawBorder: false,
                        color: 'rgba(0, 0, 0, 0.05)'
                    },
                    ticks: {
                        stepSize: 5
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
</script>

<style>
    /* Özel Stiller */
    .card-statistics {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        border: none;
    }

        .card-statistics:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .card-statistics .card-body {
            padding: 1.5rem;
        }

        .card-statistics i.icon-lg {
            font-size: 2.5rem;
            opacity: 0.7;
        }

        .card-statistics .font-weight-medium {
            font-size: 1.5rem;
            font-weight: 600 !important;
        }

    .chart-container {
        position: relative;
        height: 100%;
        min-height: 250px;
    }

    .quick-access-buttons .btn {
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        position: relative;
        overflow: hidden;
    }

        .quick-access-buttons .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .quick-access-buttons .btn i {
            font-size: 1.25rem;
            vertical-align: middle;
        }

    .todo-list li {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        background-color: #f8f9fa;
        transition: all 0.3s ease;
    }

        .todo-list li:hover {
            background-color: #e9ecef;
        }

    .todo-list .remove {
        opacity: 0;
        transition: all 0.3s ease;
    }

    .todo-list li:hover .remove {
        opacity: 1;
    }

    /* Responsive Adjustments */
    @@media (max-width: 992px) {
        .card-statistics .card-body {
            padding: 1.25rem;
        }

        .card-statistics i.icon-lg {
            font-size: 2rem;
        }

        .card-statistics .font-weight-medium {
            font-size: 1.25rem;
        }

        .quick-access-buttons .btn {
            padding: 0.75rem;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 768px) {
        .page-title {
            font-size: 1.25rem;
        }

        .card-statistics {
            margin-bottom: 1rem;
        }

        .quick-access-buttons .btn {
            margin-bottom: 0.5rem;
        }
    }

    @@media (max-width: 576px) {
        .card-statistics .card-body {
            padding: 1rem;
        }

        .card-statistics i.icon-lg {
            font-size: 1.75rem;
        }

        .card-statistics .font-weight-medium {
            font-size: 1.1rem;
        }

        .quick-access-buttons .btn {
            padding: 0.6rem;
            font-size: 0.8rem;
        }

        .todo-list li {
            padding: 0.5rem;
        }
    }
</style>