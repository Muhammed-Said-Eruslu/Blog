@{
    ViewBag.Title = "Dashboard";
    Layout = "_AdminLayout";
}
<h1>Admin</h1>
<div class="row">
    <!-- İstatistik Kartları -->
    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex align-items-center align-self-start">
                            <h3 class="mb-0">$12.34</h3>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="icon icon-box-success">
                            <span class="mdi mdi-arrow-top-right icon-item"></span>
                        </div>
                    </div>
                </div>
                <h6 class="text-muted font-weight-normal">Toplam Gelir</h6>
            </div>
        </div>
    </div>

    <!-- Diğer istatistik kartları... -->
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Son Aktivite</h4>
                <canvas id="activity-chart"></canvas>
            </div>
        </div>
    </div>
</div>

<style>
    /* Kart Stilleri */
    .card {
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        border: none;
        transition: transform 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    /* Grafik Konteynırı */
    .chart-container {
        position: relative;
        height: 400px;
    }
</style>