<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Connect Plus</title>

    <!-- Connect Plus / MDI / Flag Icons / Vendor CSS -->
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/flag-icon-css/css/flag-icon.min.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/css/style.css" />
    <link rel="shortcut icon" href="~/connect-plus-1.0.0/assets/images/favicon.png" />

    <!-- Bootstrap 4.5.2 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            z-index: 1000;
            background: #fff;
        }

        .main-panel {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            transition: margin-left 0.3s;
        }

        .navbar {
            padding-left: 250px; /* Üst navbar soldan 250px boşlukla başlar */
        }

        .content-wrapper {
            padding: 20px;
            background: #f8f9fa;
            min-height: calc(100vh - 80px);
        }

        .fixed-navbar {
            position: fixed;
            right: 0;
            left: 250px;
            z-index: 1030;
        }
    </style>
</head>
<body>
    <div class="container-scroller">
        <!-- Navbar -->
        <nav class="navbar default-layout-navbar fixed-navbar col-lg-12 col-12 p-0 d-flex flex-row">
            <div class="text-center navbar-brand-wrapper">
                <a class="navbar-brand brand-logo" href="#">
                    <img src="~/connect-plus-1.0.0/assets/images/logo.svg" alt="logo" />
                </a>
                <a class="navbar-brand brand-logo-mini" href="#">
                    <img src="~/connect-plus-1.0.0/assets/images/logo-mini.svg" alt="logo" />
                </a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <!-- Tek Arama Çubuğu -->
                <form class="d-none d-md-flex ml-3">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search..." aria-label="Search" />
                        <div class="input-group-append">
                            <button class="btn btn-outline-light" type="button">
                                <i class="mdi mdi-magnify"></i>
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Sağ Üst Menü -->
                <ul class="navbar-nav navbar-nav-right ml-auto">
                    <!-- Profil Dropdown veya Giriş Yap -->
                    <li class="nav-item nav-profile dropdown">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Oturum AÇILMIŞ ise -->
                            <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-toggle="dropdown">
                                <div class="nav-profile-img">
                                    <img src="~/connect-plus-1.0.0/assets/images/faces/face28.png" alt="profile" />
                                </div>
                                <div class="nav-profile-text">
                                    <p class="mb-1 text-black">@User.Identity.Name</p>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="profileDropdown">
                                <div class="dropdown-header">
                                    <div class="d-flex align-items-center">
                                        <img src="~/images/profil.jpg" class="rounded-circle mr-2" width="40" alt="Profil" />
                                        <div>
                                            <h6 class="mb-0">@User.Identity.Name</h6>
                                            <small>Administrator</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#">
                                    <i class="mdi mdi-account-edit mr-2"></i> Profili Düzenle
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="mdi mdi-settings mr-2"></i> Ayarlar
                                </a>
                                <div class="dropdown-divider"></div>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="mdi mdi-logout mr-2"></i> Çıkış Yap
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <!-- Oturum AÇIK DEĞİL ise -->
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <div class="nav-profile-img">
                                    <img src="~/connect-plus-1.0.0/assets/images/faces/face28.png" alt="profile" />
                                </div>
                                <div class="nav-profile-text">
                                    <p class="mb-1 text-black">Giriş Yap</p>
                                </div>
                            </a>
                        }
                    </li>

                    <!-- Bildirimler -->
                    <li class="nav-item dropdown">
                        <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-toggle="dropdown">
                            <i class="mdi mdi-bell-outline"></i>
                            <span class="count-symbol bg-danger"></span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <h6 class="p-3 mb-0">Bildirimler</h6>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item">
                                <i class="mdi mdi-alert-circle-outline mr-2"></i> Yeni mesajınız var
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav">
                <li class="nav-item nav-category">Ana Menü</li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index","Admin")">
                        <span class="icon-bg"><i class="mdi mdi-view-dashboard"></i></span>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="collapse" href="#tables">
                        <span class="icon-bg"><i class="mdi mdi-table-large"></i></span>
                        <span class="menu-title">Tablolar</span>
                        <i class="menu-arrow"></i>
                    </a>
                    <div class="collapse" id="tables">
                        <ul class="nav flex-column sub-menu">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Category")">Kategoriler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Comment")">Yorumlar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Post")">Postlar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","PostTag")">PostTag</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Tag")">Tag</a>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Ana İçerik -->
        <div class="main-panel">
            <div class="content-wrapper">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="d-sm-flex justify-content-center justify-content-sm-between">
                    <span class="text-muted d-block text-center text-sm-left">
                        © @DateTime.Now.Year Connect Plus
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scriptler -->
    <script src="~/connect-plus-1.0.0/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/off-canvas.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/hoverable-collapse.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/misc.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/dashboard.js"></script>

    <!-- SweetAlert2 -->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Bootstrap 4.5.2 (CDN) + Bundle (Popper içerir) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
