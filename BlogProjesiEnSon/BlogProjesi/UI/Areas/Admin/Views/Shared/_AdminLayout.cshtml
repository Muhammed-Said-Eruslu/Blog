<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Connect Plus | @ViewData["Title"]</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/connect-plus-1.0.0/assets/images/favicon.png" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/connect-plus-1.0.0/assets/css/style.css" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/css/admin-theme.css" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/perfect-scrollbar@1.5.5/css/perfect-scrollbar.min.css" />

    @RenderSection("Styles", required: false)

    <!-- Modern Design CSS -->
    <style>
        :root {
            --primary-color: #4B49AC;
            --secondary-color: #7DA0FA;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --warning-color: #fd7e14;
            --info-color: #17a2b8;
            --dark-color: #343a40;
            --light-color: #f8f9fa;
            --sidebar-width: 260px;
            --navbar-height: 70px;
            --transition-speed: 0.3s;
        }

        /* Base Structure */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fb;
            color: #495057;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            width: var(--sidebar-width);
            height: 100vh;
            z-index: 1050;
            background: #ffffff;
            box-shadow: 0 0 28px 0 rgba(82, 63, 105, 0.08);
            transition: all var(--transition-speed) ease;
            transform: translateX(0);
        }

        .sidebar-brand {
            height: var(--navbar-height);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .sidebar-nav {
            padding: 1rem 0;
            overflow-y: auto;
            height: calc(100vh - var(--navbar-height));
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #6c757d;
            transition: all 0.15s ease;
        }

            .nav-link:hover,
            .nav-link.active {
                color: var(--primary-color);
                background-color: rgba(75, 73, 172, 0.05);
            }

            .nav-link i {
                font-size: 1.25rem;
                margin-right: 0.75rem;
                width: 24px;
                text-align: center;
            }

        .nav-category {
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #adb5bd;
        }

        .sub-menu {
            padding-left: 2.5rem;
            background-color: rgba(0, 0, 0, 0.02);
        }

        /* Main Content Area */
        .main-panel {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            transition: all var(--transition-speed) ease;
            display: flex;
            flex-direction: column;
        }

        .content-wrapper {
            flex: 1;
            padding: 1.5rem;
            margin-top: var(--navbar-height);
            background-color: #f5f7fb;
        }

        /* Navbar Styling */
        .navbar {
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            height: var(--navbar-height);
            z-index: 1030;
            background: #ffffff;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(33, 40, 50, 0.15);
            transition: all var(--transition-speed) ease;
            padding: 0 1.5rem;
        }

        .navbar-brand {
            font-weight: 600;
            color: var(--dark-color);
        }

        .navbar-search {
            max-width: 25rem;
        }

            .navbar-search .form-control {
                border-radius: 2rem;
                padding-left: 1.5rem;
                border-color: #e9ecef;
            }

            .navbar-search .btn {
                position: absolute;
                right: 0;
                top: 0;
                border: none;
                background: transparent;
            }

        /* Notification & Profile Dropdown */
        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            min-width: 15rem;
        }

        .dropdown-header {
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .dropdown-item {
            padding: 0.5rem 1.5rem;
        }

            .dropdown-item i {
                width: 1.25rem;
                text-align: center;
                margin-right: 0.5rem;
            }

        /* Burger Menu Button */
        .sidebar-toggle {
            display: none;
            position: fixed;
            left: 1rem;
            top: 1rem;
            z-index: 1060;
            background: #ffffff;
            border: none;
            border-radius: 50%;
            width: 2.5rem;
            height: 2.5rem;
            box-shadow: 0 0 1rem rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition: all var(--transition-speed) ease;
        }

            .sidebar-toggle i {
                font-size: 1.25rem;
                color: var(--primary-color);
            }

        /* Sidebar Overlay */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1040;
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition-speed) ease;
        }

            .sidebar-overlay.active {
                opacity: 1;
                visibility: visible;
            }

        /* Mobile Responsiveness */
        @@media (max-width: 992px) {
            .sidebar

        {
            transform: translateX(calc(-1 * var(--sidebar-width)));
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .main-panel {
            margin-left: 0;
            width: 100%;
        }

        .navbar {
            left: 0;
        }

        .sidebar-toggle {
            display: block;
        }

        .sidebar-overlay.active {
            display: block;
        }

        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }

        /* Card Styling */
        .card {
            border: none;
            border-radius: 0.5rem;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(33, 40, 50, 0.15);
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 1rem 1.5rem;
        }

        .card-title {
            font-weight: 600;
            margin-bottom: 0;
        }

        /* Footer Styling */
        .footer {
            padding: 1.5rem;
            background-color: #ffffff;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Utility Classes */
        .text-primary {
            color: var(--primary-color) !important;
        }

        .bg-primary {
            background-color: var(--primary-color) !important;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-primary:hover {
                background-color: #3a3893;
                border-color: #3a3893;
            }
    </style>
</head>
<body>
    <!-- Sidebar Toggle Button -->
    <button class="sidebar-toggle" id="sidebarToggle">
        <i class="mdi mdi-menu"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="container-scroller">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <!-- Search Form -->
                <form class="navbar-search d-none d-md-flex">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Ara..." aria-label="Search">
                        <button class="btn" type="submit">
                            <i class="mdi mdi-magnify"></i>
                        </button>
                    </div>
                </form>

                <!-- Right Side Menu -->
                <ul class="navbar-nav ms-auto">
                    <!-- Notifications -->
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-bell-outline"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                3
                            </span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationDropdown">
                            <h6 class="dropdown-header">Bildirimler</h6>
                            <a class="dropdown-item" href="#">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <div class="bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center">
                                            <i class="mdi mdi-email text-white"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="small text-gray-500">5 dakika önce</div>
                                        <span class="fw-bold">Yeni mesajınız var</span>
                                    </div>
                                </div>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-center small text-gray-500" href="#">Tüm bildirimleri gör</a>
                        </div>
                    </li>

                    <!-- User Profile -->
                    <li class="nav-item dropdown ms-3">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar avatar-sm me-2">
                                <img class="rounded-circle" src="~/connect-plus-1.0.0/assets/images/faces/face28.png" alt="User">
                            </div>
                            <span class="d-none d-lg-inline">@User.Identity.Name</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <div class="dropdown-header">
                                <div class="d-flex align-items-center">
                                    <div class="avatar me-3">
                                        <img class="rounded-circle" src="~/connect-plus-1.0.0/assets/images/faces/face28.png" alt="User">
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@User.Identity.Name</h6>
                                        <small class="text-muted">Yönetici</small>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">
                                <i class="mdi mdi-account me-2"></i> Profil
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="mdi mdi-cog me-2"></i> Ayarlar
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="@Url.Action("Logout","Admin")">
                                <i class="mdi mdi-logout me-2"></i> Çıkış Yap
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <img src="~/connect-plus-1.0.0/assets/images/logo.svg" alt="Connect Plus" height="30">
            </div>
            <div class="sidebar-nav">
                <ul class="nav">
                    <li class="nav-item nav-category">Ana Menü</li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Admin", new {area ="Admin" })">
                            <i class="mdi mdi-view-dashboard"></i>
                            <span class="menu-title">Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#tables" role="button" aria-expanded="false" aria-controls="tables">
                            <i class="mdi mdi-table"></i>
                            <span class="menu-title">Tablolar</span>
                            <i class="mdi mdi-chevron-down menu-arrow"></i>
                        </a>
                        <div class="collapse" id="tables">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Category", new {area ="Admin" })">Kategoriler</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Comment", new {area ="Admin" })">Yorumlar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Post", new {area ="Admin" })">Postlar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","PostTag", new {area ="Admin" })">PostTag</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Tag", new {area ="Admin" })">Tag</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Contact", new {area ="Admin" })">Mesajlar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index","Photo", new {area ="Admin" })">Fotoğraflar</a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-panel">
            <div class="content-wrapper">
                <!-- Page Header -->
                <div class="page-header">
                    <h3 class="page-title">
                        <span class="page-title-icon bg-gradient-primary text-white me-2">
                            <i class="mdi mdi-home"></i>
                        </span>
                        @ViewData["Title"]
                    </h3>
                    <nav aria-label="breadcrumb">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item active" aria-current="page">
                                <span></span>@ViewData["Title"] &nbsp;
                                <i class="mdi mdi-alert-circle-outline text-warning icon-sm"></i>
                            </li>
                        </ul>
                    </nav>
                </div>

                <!-- Dynamic Content -->
                <div class="row">
                    <div class="col-12">
                        @RenderBody()
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted d-block text-center text-sm-left d-sm-inline-block">
                            Copyright © @DateTime.Now.Year Connect Plus. Tüm hakları saklıdır.
                        </span>
                        <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">
                            <i class="mdi mdi-heart text-danger"></i> Premium Admin Paneli
                        </span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/connect-plus-1.0.0/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/off-canvas.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/hoverable-collapse.js"></script>
    <script src="~/connect-plus-1.0.0/assets/js/misc.js"></script>

    <!-- Vendor Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/perfect-scrollbar@1.5.5/dist/perfect-scrollbar.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom Scripts -->
    <script>
        // Sidebar Toggle Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const body = document.body;

            // Toggle Sidebar
            function toggleSidebar() {
                sidebar.classList.toggle('open');
                sidebarOverlay.classList.toggle('active');
                body.classList.toggle('sidebar-open');
            }

            // Event Listeners
            sidebarToggle.addEventListener('click', toggleSidebar);
            sidebarOverlay.addEventListener('click', toggleSidebar);

            // Initialize Perfect Scrollbar
            new PerfectScrollbar('.sidebar-nav', {
                suppressScrollX: true
            });

            // Close sidebar when clicking on nav-link in mobile view
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        toggleSidebar();
                    }
                });
            });

            // Initialize DataTables
            $('.datatable').DataTable({
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json'
                }
            });
        });

        // Active Menu Item Highlighting
        $(document).ready(function() {
            const currentUrl = window.location.pathname;
            $('.nav-link').each(function() {
                if ($(this).attr('href') === currentUrl) {
                    $(this).addClass('active');
                    $(this).closest('.collapse').addClass('show');
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>