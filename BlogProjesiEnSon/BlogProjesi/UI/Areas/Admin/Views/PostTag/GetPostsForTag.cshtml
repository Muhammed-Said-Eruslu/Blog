@using Business.DTOs.PostDTOs
@model List<PostDTO>

@{
    ViewData["Title"] = "Etikete Ait Post'lar";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h2 class="mb-4">Etikete Ait Post'lar</h2>

    @if (Model.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Post ID</th>
                    <th>Başlık</th>
                    <th>Yazar</th>
                    <th>Oluşturulma Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td>@post.Id</td>
                        <td>@post.Title</td>
                        <td>@post.Author</td>
                        <td>@post.CreatedDate.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Bu etikete ait post bulunamadı.</p>
    }

    <a href="@Url.Action("Index", "Tag")" class="btn btn-secondary">Geri Dön</a>
</div>
