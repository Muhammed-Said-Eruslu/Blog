@using Business.DTOs.PostTagDTOs
@model IEnumerable<PostTagDTO>

@{
    ViewData["Title"] = "PostTag - Index";
    Layout = "_AdminLayout";
}

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    /* Tabloyu responsive yapmak için */
    .table-responsive {
        overflow-x: auto;
        max-width: 100%;
    }

    /* Aktif & Pasif Durumları için stil */
    .badge-active {
        background-color: #28a745;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
    }

    .badge-inactive {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
    }

    /* Buton grubu hizalama */
    .top-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fas fa-tags"></i> PostTag Listesi
            </h4>
        </div>

        <div class="card-body">
            <!-- Başarı / Hata Mesajları -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <!-- Üst kısımdaki butonlar -->
            <div class="top-buttons mb-3">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> Yeni PostTag Ekle
                </a>
            </div>

            <!-- DataTable -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="postTagTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Post Adı</th>
                            <th>Tag Adı</th>
                            <th>Aktiflik Durumu</th>
                            <th>Oluşturulma Tarihi</th>
                            <th>Güncellenme Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pt in Model.Select((item, index) => new { Item = item, Index = index + 1 }))
                        {
                            <tr>
                                <td>@pt.Index</td>
                                <td>@pt.Item.PostTitle</td>
                                <td>@pt.Item.TagName</td>
                                <td>
                                    @if (pt.Item.IsActive)
                                    {
                                        <span class="badge badge-active"><i class="fas fa-check-circle"></i> Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive"><i class="fas fa-times-circle"></i> Pasif</span>
                                    }
                                </td>
                                <td>@pt.Item.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@(pt.Item.UpdatedAt.HasValue ? pt.Item.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "Güncellenmedi")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@pt.Item.Id"
                                       class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Detay
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@pt.Item.Id"
                                       class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Düzenle
                                    </a>

                                    <!-- Yeni Butonlar (Form ile POST Kullanımı) -->
                                    <form asp-action="AssignTagsToPost" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@pt.Item.PostId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fas fa-plus"></i> Etiket Ekle
                                        </button>
                                    </form>

                                    <form asp-action="UnassignTagsFromPost" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@pt.Item.PostId" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-minus"></i> Etiket Kaldır
                                        </button>
                                    </form>

                                    <form asp-action="ClearTagsFromPost" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@pt.Item.PostId" />
                                        <button type="submit" class="btn btn-sm btn-dark">
                                            <i class="fas fa-trash"></i> Tüm Etiketleri Kaldır
                                        </button>
                                    </form>

                                    <form asp-action="ToggleTagStatusInPost" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postTagId" value="@pt.Item.Id" />
                                        <button type="submit" class="btn btn-sm btn-secondary">
                                            <i class="fas fa-toggle-on"></i> Durumu Değiştir
                                        </button>
                                    </form>

                                    <!-- SweetAlert silme onayı için form -->
                                    <form method="post"
                                          asp-action="DeleteConfirmed"
                                          onsubmit="return confirmDelete(this);"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@pt.Item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery & DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('#postTagTable').DataTable({
                scrollX: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json"
                }
            });
        });

        function confirmDelete(form) {
            event.preventDefault();
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu PostTag'i silmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }
    </script>
}
