@using Business.DTOs.PostTagDTOs
@model PostTagDTO
@{
    ViewData["Title"] = "PostTag - Details";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .detail-card {
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
    }

    .detail-card-header {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        padding: 1.5rem;
        border-bottom: none;
    }

    .detail-card-title {
        font-weight: 600;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .detail-icon {
        margin-right: 10px;
    }

    .detail-badge {
        padding: 0.5em 0.8em;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 4px;
    }

    .detail-item {
        margin-bottom: 1.5rem;
    }

    .detail-label {
        font-weight: 600;
        color: #5a5c69;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

        .detail-label i {
            width: 24px;
            text-align: center;
            margin-right: 8px;
            color: #dddfeb;
        }

    .detail-value {
        color: #858796;
        padding-left: 32px;
    }

    .card-footer {
        background-color: #f8f9fc;
        border-top: 1px solid #e3e6f0;
        padding: 1.25rem 1.5rem;
    }

    .btn-detail {
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .btn-back {
        background-color: #f8f9fc;
        color: #4e73df;
        border: 1px solid #d1d3e2;
    }

        .btn-back:hover {
            background-color: #e2e6f0;
        }

    .alert-danger {
        border-left: 4px solid #e74a3b;
    }

    @@media (max-width: 768px) {
        .detail-card-header {
            padding: 1rem;
        }

        .detail-item {
            margin-bottom: 1.2rem;
        }
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">PostTag Detayları</h1>
        <a asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Listeye Dön
        </a>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card detail-card mb-4">
                <div class="card-header detail-card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-white detail-card-title">
                        <i class="fas fa-tags detail-icon"></i>PostTag Bilgileri
                    </h6>
                    <a asp-action="Index" class="btn btn-sm btn-light btn-circle">
                        <i class="fas fa-times text-gray-600"></i>
                    </a>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-id-badge"></i>PostTag ID
                                </div>
                                <div class="detail-value">@Model.Id</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-sticky-note"></i>Post Adı
                                </div>
                                <div class="detail-value">
                                    <span class="badge bg-primary detail-badge">@Model.PostTitle</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-hashtag"></i>Tag Adı
                                </div>
                                <div class="detail-value">
                                    <span class="badge bg-success detail-badge">@Model.TagName</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-toggle-on"></i>Durum
                                </div>
                                <div class="detail-value">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success detail-badge">
                                            <i class="fas fa-check-circle me-1"></i>Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger detail-badge">
                                            <i class="fas fa-times-circle me-1"></i>Pasif
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-plus"></i>Oluşturulma Tarihi
                                </div>
                                <div class="detail-value">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-check"></i>Güncellenme Tarihi
                                </div>
                                <div class="detail-value">
                                    @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMMM yyyy HH:mm") : "Henüz güncellenmedi")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-detail">
                        <i class="fas fa-edit me-1"></i>Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-detail">
                        <i class="fas fa-arrow-left me-1"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>