@using Business.DTOs.PostTagDTOs
@model PostTagDTO
@{
    ViewData["Title"] = "PostTag - Düzenle";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .edit-card {
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
    }

    .edit-card-header {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        padding: 1.5rem;
        border-bottom: none;
    }

    .edit-card-title {
        font-weight: 600;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .edit-icon {
        margin-right: 10px;
    }

    .form-label {
        font-weight: 600;
        color: #5a5c69;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

        .form-label i {
            width: 24px;
            text-align: center;
            margin-right: 8px;
            color: #dddfeb;
        }

    .form-control:read-only {
        background-color: #f8f9fc;
        border-color: #e3e6f0;
        cursor: not-allowed;
    }

    .custom-switch {
        padding-left: 3.5rem;
    }

        .custom-switch .custom-control-label::before {
            left: -3.5rem;
            width: 3rem;
            height: 1.5rem;
            border-radius: 1rem;
        }

        .custom-switch .custom-control-label::after {
            top: calc(.25rem + 2px);
            left: calc(-3.5rem + 2px);
            width: calc(1.5rem - 4px);
            height: calc(1.5rem - 4px);
            border-radius: 1rem;
        }

        .custom-switch .custom-control-input:checked ~ .custom-control-label::after {
            transform: translateX(1.4rem);
        }

    .card-footer {
        background-color: #f8f9fc;
        border-top: 1px solid #e3e6f0;
        padding: 1.25rem 1.5rem;
    }

    .btn-edit {
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .btn-back {
        background-color: #f8f9fc;
        color: #4e73df;
        border: 1px solid #d1d3e2;
    }

        .btn-back:hover {
            background-color: #e2e6f0;
        }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .edit-card-header {
            padding: 1rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">PostTag Düzenle</h1>
        <a asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Listeye Dön
        </a>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card edit-card mb-4">
                <div class="card-header edit-card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-white edit-card-title">
                        <i class="fas fa-edit edit-icon"></i>PostTag Bilgilerini Düzenle
                    </h6>
                    <a asp-action="Index" class="btn btn-sm btn-light btn-circle">
                        <i class="fas fa-times text-gray-600"></i>
                    </a>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="form-label" for="PostTitle">
                                        <i class="fas fa-sticky-note"></i>Post Adı
                                    </label>
                                    <input type="text" class="form-control" value="@Model.PostTitle" readonly />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="form-label" for="TagName">
                                        <i class="fas fa-hashtag"></i>Tag Adı
                                    </label>
                                    <input type="text" class="form-control" value="@Model.TagName" readonly />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="form-label" for="IsActive">
                                        <i class="fas fa-toggle-on"></i>Durum
                                    </label>
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="IsActiveSwitch" asp-for="IsActive">
                                        <label class="custom-control-label" for="IsActiveSwitch">
                                            @(Model.IsActive ? "Aktif" : "Pasif")
                                        </label>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <button type="submit" class="btn btn-warning btn-edit">
                            <i class="fas fa-save me-1"></i>Güncelle
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-edit">
                            <i class="fas fa-arrow-left me-1"></i>Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Switch butonu için dinamik etiket değişimi
    document.getElementById('IsActiveSwitch').addEventListener('change', function() {
        const label = document.querySelector('label[for="IsActiveSwitch"]');
        label.textContent = this.checked ? 'Aktif' : 'Pasif';
    });
</script>