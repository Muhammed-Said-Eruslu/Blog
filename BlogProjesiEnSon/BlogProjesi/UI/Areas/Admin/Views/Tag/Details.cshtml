@model Business.DTOs.TagDTOs.TagDTO

@{
    ViewData["Title"] = "Etiket Detayları";
    Layout = "_AdminLayout";
}

<style>
    .detail-card {
        border: none;
        border-radius: 0.5rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        transition: all 0.3s ease;
    }

    .detail-card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
    }

    .detail-card-body {
        padding: 2rem;
    }

    .detail-item {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e3e6f0;
    }

        .detail-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .detail-label {
        font-weight: 600;
        color: #5a5c69;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        font-size: 1.1rem;
    }

    .post-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .post-list-item {
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
    }

        .post-list-item:hover {
            background-color: #f8f9fc;
            border-left: 3px solid #4e73df;
        }

    .action-buttons .btn {
        min-width: 120px;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .detail-card-body {
            padding: 1.5rem;
        }

        .action-buttons .btn {
            width: 100%;
            margin-right: 0;
        }

        .detail-item {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
        }
    }
</style>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Etiket Yönetimi</a></li>
                <li class="breadcrumb-item active" aria-current="page">Detaylar</li>
            </ol>
        </nav>
    </div>

    <!-- Detail Card -->
    <div class="card detail-card mb-4">
        <div class="card-header detail-card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="m-0 text-white">
                    <i class="fas fa-tag mr-2"></i>Etiket Bilgileri
                </h4>
                <span class="badge bg-light text-dark">
                    ID: @Model.Id
                </span>
            </div>
        </div>
        <div class="card-body detail-card-body">
            <!-- Basic Information -->
            <div class="detail-item">
                <h5 class="detail-label">Temel Bilgiler</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-3">
                            <span class="detail-label">Etiket Adı:</span>
                            <span class="detail-value d-block">@Model.Name</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-3">
                            <span class="detail-label">Slug (URL Adı):</span>
                            <span class="detail-value d-block">@Model.Slug</span>
                        </p>
                    </div>
                </div>
                <p class="mb-3">
                    <span class="detail-label">Açıklama:</span>
                    <span class="detail-value d-block">
                        @(string.IsNullOrEmpty(Model.Description) ? "Açıklama eklenmemiş." : Model.Description)
                    </span>
                </p>
            </div>

            <!-- Status and Dates -->
            <div class="detail-item">
                <h5 class="detail-label">Durum ve Zaman Bilgileri</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-3">
                            <span class="detail-label">Durum:</span>
                            <span class="detail-value d-block">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success py-2 px-3">
                                        <i class="fas fa-check-circle mr-1"></i>Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger py-2 px-3">
                                        <i class="fas fa-times-circle mr-1"></i>Pasif
                                    </span>
                                }
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-3">
                            <span class="detail-label">Oluşturulma Tarihi:</span>
                            <span class="detail-value d-block">
                                <i class="far fa-calendar-alt mr-2"></i>
                                @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Related Posts -->
            <div class="detail-item">
                <h5 class="detail-label">İlişkili Gönderiler</h5>
                @if (Model.PostTags != null && Model.PostTags.Any())
                {
                    <div class="post-list">
                        <div class="list-group">
                            @foreach (var postTag in Model.PostTags)
                            {
                                <a asp-area="Admin" asp-controller="Post" asp-action="Details" asp-route-id="@postTag.PostId"
                                   class="list-group-item list-group-item-action post-list-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@postTag.PostTitle</h6>
                                        <small class="text-muted">@postTag.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <small class="text-muted">@(postTag.PostTitle ?? "")</small>
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-2"></i>
                        Bu etiket herhangi bir gönderiye eklenmemiş.
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 pt-3 border-top action-buttons">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit mr-2"></i>Düzenle
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>Listeye Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to top button functionality
        $(document).ready(function() {
            $(window).scroll(function() {
                if ($(this).scrollTop() > 100) {
                    $('.scroll-to-top').fadeIn();
                } else {
                    $('.scroll-to-top').fadeOut();
                }
            });

            $('.scroll-to-top').click(function() {
                $('html, body').animate({scrollTop: 0}, 800);
                return false;
            });
        });
    </script>
}